<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- 仅测试用：21 个测试文件的历史 LoadPngBgra 加载器 + letterbox 等价性对照的参照实现。
         主工程已移除 OpenCvSharp（见主 csproj），此引用不随发布 -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240615" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240615" />
    <!-- 仅 OCR 横评（OcrModelSweep20261023）用：Tesseract 5 异族基线，不随发布 -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用主项目（WinExe 亦可作为引用项目，测试其输出程序集） -->
    <ProjectReference Include="..\..\src\EfootballBot\EfootballBot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 官方 yolo26n 模型随测试输出分发（模型加载冒烟测试用） -->
    <None Include="..\..\src\EfootballBot\models\yolo\**\*.*" Link="models\yolo\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
