<Window x:Class="EfootballBot.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时图谱 — 流程步骤与判定" Width="1180" Height="560"
        MinWidth="900" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：模块切换 + 当前画面 -->
        <Grid>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabModeLeague" Content="我的联赛" Style="{StaticResource SegTab}"
                             Padding="12,4" FontSize="12" IsChecked="True" Checked="ModeTab_Checked"/>
                <RadioButton x:Name="TabModeWeekly" Content="国际服活动" Style="{StaticResource SegTab}"
                             Padding="12,4" FontSize="12" Margin="6,0,0,0" Checked="ModeTab_Checked"/>
                <RadioButton x:Name="TabModeCn" Content="国服每日" Style="{StaticResource SegTab}"
                             Padding="12,4" FontSize="12" Margin="6,0,0,0" Checked="ModeTab_Checked"/>
                <Ellipse x:Name="DotCurrent" Width="10" Height="10" Fill="{DynamicResource EnvDotIdle}"
                         VerticalAlignment="Center" Margin="20,0,9,0"/>
                <TextBlock x:Name="TxtCurrent" Text="当前画面：—" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextMuted}"
                       Text="总—分—总：绿色脉冲=当前步骤　点击任一步骤卡片查看该步骤细看（8 秒内不自动跳转）"/>
        </Grid>

        <!-- 中部：总分总 -->
        <Grid Grid.Row="1" Margin="0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 总：编号步骤链（横向，单页自适应缩放，可点击展开） -->
            <Border Background="{DynamicResource PreviewBg}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="8,6" ClipToBounds="True">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <StackPanel Orientation="Horizontal" x:Name="StepsHost" Margin="4"/>
                </Viewbox>
            </Border>

            <!-- 分：选中步骤详情 -->
            <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource PreviewBg}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="14,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailHost"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 总：实时判定依据 -->
        <Border Grid.Row="2" Background="{DynamicResource Surface2}" CornerRadius="10"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="12,9">
            <TextBlock x:Name="TxtDetail" Text="判定依据：—" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
