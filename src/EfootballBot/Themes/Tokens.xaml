<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ==================================================================
         Tokens.xaml —— 颜色 / 阴影：全应用唯一的颜色真相（v7.4 · 两个视觉世界）
         改配色只动这里 + Core/UI/ThemePalette.cs（2 世界 × 3 亮度的六张同名表）。
         世界 1 Fluent（默认）：Windows 11 云母/亚克力 + 系统强调蓝，v7.3 原始观感；
         世界 2 Glass       ：Apple 黑玻璃 —— 近纯黑毛玻璃 + 中性浅灰选中 + 玻璃渐变卡片。
         本文件的数值只是 Glass 暗色的「兜底 / 设计器预览」值：运行时 ApplyTheme 会按
         (Theme, Appearance.World) 覆盖全部 token，并重建 GlassFill / PrimaryBtnFill /
         CardShadowEffect / DitherNoiseBrush 这四个复合资源。
         页面里只准引用 token，不写十六进制。
         ================================================================== -->
    <!-- ===== 底层：窗口与三栏（都带透明度，让材质从后面透出来） ===== -->
    <SolidColorBrush x:Key="WindowBg" Color="#FF08080A"/>
    <SolidColorBrush x:Key="ContentBg" Color="#F208080A"/>
    <SolidColorBrush x:Key="CardBg" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="SideLeftBg" Color="#59000000"/>
    <SolidColorBrush x:Key="SideRightBg" Color="#42000000"/>
    <SolidColorBrush x:Key="Surface2" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="InsetBg" Color="#0A000000"/>
    <SolidColorBrush x:Key="TrackBg" Color="#4D000000"/>
    <SolidColorBrush x:Key="GlassBg" Color="#D9101012"/>
    <SolidColorBrush x:Key="GlassStroke" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="DialogBg" Color="#F516161A"/>
    <SolidColorBrush x:Key="ControlFill" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="ControlStroke" Color="#2EFFFFFF"/>
    <!-- 顶栏/左栏的淡黑玻璃蒙版：护住导航文字可读性，同时保留毛玻璃透射 -->
    <SolidColorBrush x:Key="ChromeGlass" Color="#4D08080A"/>

    <!-- ===== 文字（Apple 三级：主 白 / 次 #E5E5EA / 弱 #98989F） ===== -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF98989F"/>
    <SolidColorBrush x:Key="NavLabelFg" Color="#FF98989F"/>
    <SolidColorBrush x:Key="NavDescFg" Color="#FFB8B8BF"/>
    <SolidColorBrush x:Key="SegTabFg" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="SegTabHover" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SegTabHoverFg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="LogInfo" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="LogTime" Color="#FFFFB86C"/>
    <SolidColorBrush x:Key="LogTag" Color="#FF6CB6FF"/>

    <!-- ===== 强调色（Apple 深色 = 蓝 #0A84FF，上面压白字） ===== -->
    <SolidColorBrush x:Key="Accent" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF3D9CFF"/>
    <SolidColorBrush x:Key="AccentGlow" Color="#FF7DBBFF"/>
    <SolidColorBrush x:Key="AccentLight" Color="#330A84FF"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#660A84FF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#260A84FF"/>
    <SolidColorBrush x:Key="AccentBorderStrong" Color="#990A84FF"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>

    <!-- ===== 语义色（Apple 系统色） ===== -->
    <SolidColorBrush x:Key="Danger" Color="#FFFF453A"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FFFF695F"/>
    <SolidColorBrush x:Key="DangerText" Color="#FFFF6966"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#66FF453A"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26FF453A"/>
    <SolidColorBrush x:Key="TextOnDanger" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Warning" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="Success" Color="#FF30D158"/>
    <SolidColorBrush x:Key="Info" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="Amber" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="Orange" Color="#FFFF9F0A"/>
    <SolidColorBrush x:Key="Teal" Color="#FF40C8E0"/>

    <!-- ===== 输入 / 轨道 / 滚动 ===== -->
    <SolidColorBrush x:Key="InputBg" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="InputBorder" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HoverOverlay" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ToggleOff" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="ToggleOn" Color="#FF30D158"/>
    <SolidColorBrush x:Key="ToggleThumbOn" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ModuleDot" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="EnvDotIdle" Color="#FF8E8E93"/>

    <!-- ===== 描边 / 遮罩 / 预览 ===== -->
    <SolidColorBrush x:Key="Divider" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="HairlineStrong" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="Scrim" Color="#F0000000"/>
    <SolidColorBrush x:Key="ScrimSoft" Color="#CC000000"/>
    <SolidColorBrush x:Key="PreviewBg" Color="#FF000000"/>
    <SolidColorBrush x:Key="NavSectionBg" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="NavSectionBorder" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TabTrackBg" Color="#4D000000"/>
    <SolidColorBrush x:Key="IntlTabBg" Color="#4D000000"/>
    <SolidColorBrush x:Key="IntlTabBorder" Color="#1FFFFFFF"/>

    <!-- ===== 品牌 / 横幅（Apple 蓝，不做渐变堆叠） ===== -->
    <SolidColorBrush x:Key="BrandFrom" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="BrandTo" Color="#FF0057D6"/>
    <SolidColorBrush x:Key="BannerFrom" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="BannerTo" Color="#FF0057D6"/>
    <SolidColorBrush x:Key="TextOnBanner" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="HeroGlowFrom" Color="#260A84FF"/>
    <SolidColorBrush x:Key="HeroGlowFade" Color="#000A84FF"/>
    <SolidColorBrush x:Key="HeroTitleFrom" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="HeroTitleMid" Color="#FFCFE6FF"/>
    <SolidColorBrush x:Key="HeroTitleTo" Color="#FF9CCBFF"/>

    <!-- ===== 浮层 ===== -->
    <SolidColorBrush x:Key="TooltipBg" Color="#F22C2C2E"/>
    <SolidColorBrush x:Key="TooltipBorder" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="TooltipFg" Color="#FFFFFFFF"/>

    <!-- ===== Apple 阴影：大半径、极低不透明度（浮层轻而柔） ===== -->
    <DropShadowEffect x:Key="FloatShadow" Color="#FF000000" BlurRadius="24"
                      ShadowDepth="1" Opacity="0.22"/>
    <DropShadowEffect x:Key="AccentShadow" Color="#660A84FF" BlurRadius="20"
                      ShadowDepth="1" Opacity="0.28"/>
    <!-- 玻璃卡片投影：极淡的一层，只把卡片从底材上"托"起来。
         Fluent 世界由 ApplyTheme 换成零强度投影（= 旧版卡片无阴影）。 -->
    <DropShadowEffect x:Key="CardShadowEffect" Color="#FF000000" BlurRadius="18"
                      ShadowDepth="2" Opacity="0.14"/>

    <!-- ===== 高级玻璃质感：渐变光影（高级感来自光影，不是半透明色块） =====
         渐变停点引用主题 Color token（DynamicResource 会跟随主题切换），
         具体色值由 ThemeManager.ApplyTheme 在运行时构造对应主题的渐变后覆盖。
         这里给的是暗色（默认）兜底值，保证设计器里也能预览。 -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3DFFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.16"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentPillFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
    </LinearGradientBrush>
    <!-- 主按钮：浅色玻璃质感（白→浅灰），靠描边与投影浮起，不靠蓝色色相 -->
    <LinearGradientBrush x:Key="PrimaryBtnFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF2F2F5" Offset="0.55"/>
        <GradientStop Color="#FFE2E2E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardTopHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="{DynamicResource HairlineStrongColor}" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 渐变停点专用 Color 版（GradientStop.Color 只吃 Color） ===== -->
    <Color x:Key="BrandFromColor">#FF0A84FF</Color>
    <Color x:Key="BrandToColor">#FF0057D6</Color>
    <!-- 渐变引用的兜底 Color：ApplyTheme 会在运行时按主题覆盖这些同名 key -->
    <Color x:Key="AccentColor">#FF0A84FF</Color>
    <Color x:Key="AccentHoverColor">#FF3D9CFF</Color>
    <Color x:Key="HairlineStrongColor">#3DFFFFFF</Color>
    <!-- 浅灰毛玻璃选中态兜底：ApplyTheme 运行时按主题覆盖 -->
    <SolidColorBrush x:Key="SelectFill" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="SelectFillStrong" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="SelectBorder" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="SelectFg" Color="#FFFFFFFF"/>
    <!-- 选中指示条：Fluent = 强调蓝竖条，Glass = 与选中文字同色的白色细条（ApplyTheme 派生） -->
    <SolidColorBrush x:Key="SelectBar" Color="#FFFFFFFF"/>
    <!-- 顶栏玻璃蒙版：Fluent = 透明，Glass = 与左右栏同一张淡黑玻璃 -->
    <SolidColorBrush x:Key="TopBarBg" Color="#4D08080A"/>
    <!-- 功能分类页签选中：明显的灰色磨砂方框 -->
    <SolidColorBrush x:Key="SubTabSelFill" Color="#664A4A50"/>
    <SolidColorBrush x:Key="SubTabSelStroke" Color="#4DFFFFFF"/>
    <!-- Chip（热键等标签）：深色方形毛玻璃 -->
    <SolidColorBrush x:Key="ChipFill" Color="#3D000000"/>
    <SolidColorBrush x:Key="ChipStroke" Color="#3DFFFFFF"/>
    <!-- 主按钮：文字色 / 顶高光描边 / 悬停压暗层（Fluent = 强调色按钮 + 白字 + 白色提亮） -->
    <SolidColorBrush x:Key="TextOnPrimary" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="PrimaryBtnStroke" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BtnFlash" Color="#FF9A9AA0"/>
    <!-- 下拉选择卡：本体与弹出层用更实的底色，盖住下层文字 -->
    <SolidColorBrush x:Key="ComboBg" Color="#2A242428"/>
    <SolidColorBrush x:Key="ComboPopupBg" Color="#F0161618"/>
    <Color x:Key="HeroGlowFromColor">#260A84FF</Color>
    <Color x:Key="HeroGlowFadeColor">#000A84FF</Color>
    <Color x:Key="HeroTitleFromColor">#FFFFFFFF</Color>
    <Color x:Key="HeroTitleMidColor">#FFCFE6FF</Color>
    <Color x:Key="HeroTitleToColor">#FF9CCBFF</Color>
    <Color x:Key="BannerFromColor">#FF0A84FF</Color>
    <Color x:Key="BannerToColor">#FF0057D6</Color>

    <!-- ===== 抖动噪点：打散 Acrylic 深色渐变的色带(banding) =====
         极低透明度的白噪点平铺在窗口最底层，不参与交互；视觉上几乎不可见，
         但能打散 8-bit 色深下一条一条的色阶，让毛玻璃过渡更平滑。 -->
    <ImageBrush x:Key="DitherNoiseBrush"
                ImageSource="pack://application:,,,/Assets/dither-noise.png"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute"
                Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
</ResourceDictionary>
