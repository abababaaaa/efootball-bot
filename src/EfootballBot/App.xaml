<Application x:Class="EfootballBot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ============================================================
                 设计系统「Pitch Console」入口 —— 本文件只负责「按顺序合并」，
                 样式本体一律在 Themes/ 下，改样式不要回到这里：
                   Tokens.xaml     颜色 / 阴影（唯一颜色真相，改配色只动这个）
                   Surfaces.xaml   容器与字体阶梯（Card / 标题 / 正文 / 小字）
                   Controls.xaml   交互控件（按钮 / 页签 / 勾选 / 输入 / 滚动条 / 表格）
                   Templates.xaml  页面级局部样式（横幅按钮 / 上栏页签 / 网络表格行…）
                 合并顺序 = 优先级，后合并的覆盖先合并的：
                 WPF-UI Fluent 2 基底 → 本项目 Token → 容器文字 → 控件 → 页面局部。
                 ============================================================ -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Surfaces.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
