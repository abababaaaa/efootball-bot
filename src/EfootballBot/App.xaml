<Application x:Class="EfootballBot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- ================================================================
             设计系统「Pitch Console」
             分层深蓝黑底 · 翡翠绿主色 · 发丝描边 · 12px 圆角 · 微按压缩放
             默认 Token = 暗色 Dark（ThemeManager 启动时按配置覆盖全部 Token）
             ================================================================ -->
        <SolidColorBrush x:Key="WindowBg" Color="#FF0C1015"/>
        <SolidColorBrush x:Key="CardBg" Color="#FF151B23"/>
        <SolidColorBrush x:Key="CardBorder" Color="#FF242D3A"/>
        <SolidColorBrush x:Key="SideLeftBg" Color="#FF080B0F"/>
        <SolidColorBrush x:Key="SideRightBg" Color="#FF0F141B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFECF1F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFA6B1C0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF6C7686"/>
        <SolidColorBrush x:Key="Accent" Color="#FF0FA968"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF14C07A"/>
        <SolidColorBrush x:Key="AccentGlow" Color="#FF35D392"/>
        <SolidColorBrush x:Key="AccentLight" Color="#FF1C3128"/>
        <SolidColorBrush x:Key="AccentBorder" Color="#550FA968"/>
        <SolidColorBrush x:Key="Danger" Color="#FFE5484D"/>
        <SolidColorBrush x:Key="DangerHover" Color="#FFF2595E"/>
        <SolidColorBrush x:Key="Warning" Color="#FFF2B13E"/>
        <SolidColorBrush x:Key="HoverOverlay" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#FF0F141B"/>
        <SolidColorBrush x:Key="InputBorder" Color="#FF2A3442"/>
        <SolidColorBrush x:Key="ScrollThumb" Color="#FF33404F"/>
        <SolidColorBrush x:Key="ModuleDot" Color="#FF454F5E"/>
        <SolidColorBrush x:Key="SegTabFg" Color="#FF94A0B1"/>
        <SolidColorBrush x:Key="SegTabHover" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="SegTabHoverFg" Color="#FFDCE3EC"/>
        <SolidColorBrush x:Key="LogInfo" Color="#FFC4CDD9"/>
        <SolidColorBrush x:Key="NavSectionBg" Color="#FF101722"/>
        <SolidColorBrush x:Key="NavSectionBorder" Color="#FF222C3A"/>
        <SolidColorBrush x:Key="NavLabelFg" Color="#FF6C7686"/>
        <SolidColorBrush x:Key="NavDescFg" Color="#FF818C9D"/>
        <SolidColorBrush x:Key="EnvDotIdle" Color="#FF5E6878"/>
        <SolidColorBrush x:Key="IntlTabBg" Color="#FF111823"/>
        <SolidColorBrush x:Key="IntlTabBorder" Color="#FF283242"/>
        <SolidColorBrush x:Key="PreviewBg" Color="#FF000000"/>
        <!-- 新增 Token -->
        <SolidColorBrush x:Key="Surface2" Color="#FF1B222C"/>
        <SolidColorBrush x:Key="InsetBg" Color="#FF0A0E13"/>
        <SolidColorBrush x:Key="TrackBg" Color="#FF101722"/>
        <SolidColorBrush x:Key="Scrim" Color="#F00B0F14"/>
        <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>
        <!-- v4.2 视觉重排新增 Token（三套主题都必须提供，见 ThemeManager） -->
        <SolidColorBrush x:Key="Divider" Color="#FF1E2633"/>
        <SolidColorBrush x:Key="TabTrackBg" Color="#FF0B1016"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#2AE5484D"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1F0FA968"/>

        <!-- 柔和阴影（仅用于浮层 / 横幅 / 弹窗，卡片本身用发丝描边） -->
        <DropShadowEffect x:Key="FloatShadow" Color="#FF000000" BlurRadius="24"
                          ShadowDepth="3" Opacity="0.35"/>
        <DropShadowEffect x:Key="AccentShadow" Color="#CC0FA968" BlurRadius="16"
                          ShadowDepth="2" Opacity="0.45"/>

        <!-- ============ 容器 / 文字 ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- 内嵌凹槽：日志 / 提示 / 输入组 -->
        <Style x:Key="Inset" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InsetBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- ============ 字体阶梯（全应用统一，禁止各处再手写 FontSize） ============ -->
        <!-- 页面主标题：模块页 / 设置页顶部 -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- 页面副标题：标题下的一句用途说明 -->
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="520"/>
        </Style>
        <!-- 卡片标题 -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- 卡片标题下的补充说明 -->
        <Style x:Key="CardSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <!-- 正文：说明段落 -->
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <!-- 小字：要点行 / 表单说明 -->
        <Style x:Key="SmallText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <!-- 等宽：日志 / 路径 -->
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <!-- 要点行左侧圆点 -->
        <Style x:Key="BulletDot" TargetType="Ellipse">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,9,0"/>
        </Style>
        <!-- 要点行文字（配合 BulletDot 使用：一行一句，行首不再手写「·」） -->
        <Style x:Key="BulletText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 分区小标题（运行设置 / 模块选项 / 本次运行） -->
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <!-- 卡内小节标题（声明页的分项、表单分组名） -->
        <Style x:Key="SubHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <!-- 发丝分隔线 -->
        <Style x:Key="Hairline" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource Divider}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 小胶囊标签（状态 / 平台 / 备注） -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8,2.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 侧栏分组小标题 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
        <!-- 表单字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ 左栏模块选择（胶囊 + 左侧绿色指示条） ============ -->
        <Style x:Key="ModuleRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="10" Padding="13,10" Background="Transparent"/>
                            <Rectangle x:Name="bar" Width="3" Height="18" RadiusX="1.5"
                                       Fill="{DynamicResource AccentGlow}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="4,0,0,0" Visibility="Collapsed"/>
                            <ContentPresenter Margin="13,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 左栏工具导航（图标 + 文字，Tag=Active 高亮） ============ -->
        <Style x:Key="NavToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="8" Background="Transparent"/>
                            <Rectangle x:Name="bar" Width="3" Height="15" RadiusX="1.5"
                                       Fill="{DynamicResource AccentGlow}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="3,0,0,0" Visibility="Collapsed"/>
                            <ContentPresenter Margin="11,0,8,0" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 主按钮（绿色实心，悬停提亮，按下轻微回弹） ============ -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- 顶部内高光：给实心按钮一点立体感（对绿色 / 红色按钮都成立） -->
                            <Border CornerRadius="9" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#24FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- 悬停白色高光层 -->
                            <Border x:Name="flash" CornerRadius="9" Background="White" Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="flash" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.975" ScaleY="0.975"/></Setter.Value></Setter>
                                <Setter TargetName="flash" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- 运行中「一键结束」：实心危险色（由代码 MainWindow.ModuleRun 切换样式，勿删） -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ============ 危险操作（描边版）：默认低饱和，悬停才泛红 ============ -->
        <Style x:Key="DangerOutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFE0767A"/>
            <Setter Property="BorderBrush" Value="#55E5484D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.975" ScaleY="0.975"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 文字按钮：最低视觉等级（单步调试等辅助操作） ============ -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGlow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 幽灵按钮（透明底，hover 浮现） ============ -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 复选框：默认=小型胶囊开关（开=主题绿+圆点右移）；CheckTick=方框对勾 ============ -->
        <Style x:Key="CheckTick" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Border x:Name="box" CornerRadius="5" Background="{DynamicResource InputBg}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"/>
                                <Path x:Name="check" Data="M 3.5,9.5 L 7.5,13 L 14.5,4.5"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentGlow}"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Surface2}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource CheckTick}">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 胶囊拨片：Trigger 直接驱动（勿用 VSM ColorAnimation 动画模板内联冻结画笔，会静默失效） -->
                            <Grid Grid.Column="0" Width="40" Height="22" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border x:Name="track" CornerRadius="11" Background="#FF3A4452"/>
                                <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9" Background="White"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 文本框（圆角 + 聚焦亮边） ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentGlow}"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" Focusable="False"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentGlow}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 下拉框 ============ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Background="{Binding Background,RelativeSource={RelativeSource TemplatedParent}}"
                                          BorderBrush="{Binding BorderBrush,RelativeSource={RelativeSource TemplatedParent}}"
                                          IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="7"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" ContentSource="SelectionBoxItem"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Grid Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,11,0">
                                <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource TextMuted}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                        CornerRadius="10" Margin="0,5,0,9" Padding="4"
                                        Effect="{StaticResource FloatShadow}"
                                        MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 分段页签：轨道容器 + 选中页签上浮 ============ -->
        <!-- 用法：<Border Style="{StaticResource TabTrack}"> 内放若干 SegTab -->
        <Style x:Key="TabTrack" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TabTrackBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SegTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SegTabFg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="16,6.5" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Divider}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGlow}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegTabHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SegTabHoverFg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 图标（导航 / 行内）：统一 16px、线宽 1.6、圆头 ============ -->
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ 右侧统计块 ============ -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- ============ 操作栏容器（本次运行 / 主要操作） ============ -->
        <Style x:Key="RailCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InsetBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- ============ 进度条（胶囊轨道 + 绿色填充） ============ -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource InsetBg}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{DynamicResource Accent}"
                                    CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ToolTip（深色浮层，三主题统一） ============ -->
        <Style TargetType="ToolTip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F01B222C" BorderBrush="#40566A" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" MaxWidth="340"
                                Effect="{StaticResource FloatShadow}">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"
                                       Foreground="#DCE3EC" FontSize="11.5"
                                       FontFamily="Microsoft YaHei UI"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 细滚动条 ============ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <!-- PART_Track 是 WPF 模板化部件约定名：ScrollBar 靠它找到 Track 并接通
                             值同步与滑块拖拽，缺了它 Thumb 永远拖不动（历次版本滑块失效根因） -->
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="th" Background="{DynamicResource ScrollThumb}"
                                                        CornerRadius="4" Margin="2" Opacity="0.6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
