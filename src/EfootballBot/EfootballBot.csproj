<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 默认只构建 net10（单数 TargetFramework，dotnet publish 无需 -f）；
         需要验证 net11 GA 就绪性时加 -p:BuildNet11=true（需 .NET 11 SDK，切换为复数 TargetFrameworks） -->
    <TargetFramework Condition="'$(BuildNet11)' != 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFrameworks Condition="'$(BuildNet11)' == 'true'">net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EfootballBot</AssemblyName>
    <RootNamespace>EfootballBot</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 测试版约定：4 段版本号（如 2.0.5.1）+ 同名 4 段 tag（v2.0.5.1）→ CI 按 pre-release 发布，
         更新器 Version.TryParse 原生支持、仅「包含测试版」开启的用户可见；迭代测试版递增第 4 段，
         正式版顺延三段号（2.0.6）。带横杠的 tag（v2.0.5-beta1）不可用——Version.TryParse 解析失败 -->
    <Version>5.0.0.0</Version>
    <Product>eFootball 挂机助手</Product>
    <Company>EfootballBot</Company>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 默认发布形态：单个自包含 exe（方便携带）；模型与原生库内嵌、首启自解压到 %TEMP%。
       只影响 dotnet publish，不影响普通 build/调试（如需旧的文件夹发布，命令行加 -p:PublishSingleFile=false） -->
  <PropertyGroup Condition="'$(PublishSingleFile)' != 'false'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主窗口 / exe 图标（Resource 供 WPF 窗口 Icon 引用，ApplicationIcon 供 exe 资源） -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- DXGI Desktop Duplication 捕获实现（SharpDX 统一锁定 4.2.0） -->
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <!-- 捕获家族新实现（默认）：Vortice.Direct3D11 会传递引入 Vortice.DXGI / SharpGen.Runtime。
         与 SharpDX 是两套 COM 包装，绝不可混挂同一设备指针；家族切换见 ModuleFallback.UseSharpDxCapture -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- PP-OCRv6 本地离线 OCR（ONNX Runtime，包自带 v5 检测/方向分类模型） -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <!-- SimdPaddleOCR（纯托管 PP-OCR 推理，Apache-2.0）：可选引擎，加载与 RapidV6 共用的
         models/v6 松散模型文件（不引模型包——ChineseV6Medium 包内嵌 100MB 模型会整体进 exe） -->
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
    <!-- 推理引擎：统一 1.31.0（RapidOcrNet 4.2.0 程序集级要求 ORT >= 1.29.0，1.31 满足；
         Microsoft.ML.OnnxRuntime.DirectML 原生包停更于 1.24.4 无法共存 → 实际走 CPU EP。
         OnnxSessionFactory 保留 CUDA→DirectML→CPU 降级链：无 DML 原生库时运行时探测失败自动落 CPU，
         后续接入 Windows ML EP 或更换 OCR 后端即可恢复 GPU 加速，代码无需改动。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <!-- ViGEm 客户端托管封装（v3.3.0 自 HIDMaestro 回退 ViGEmBus）：自带原生 vigemclient.dll（x64），
         与 ViGEmBus 内核驱动通信；驱动本体由内置官方安装器按需静默安装（见 DriverInstaller） -->
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <!-- YOLO letterbox 预处理已自写（ImageScaling，双线性+灰边，测试工程用 OpenCV 参照实现做逐像素等价对照）；
         主工程不再依赖 OpenCvSharp（原 OpenCvSharpExtern.dll 58.9MB + ffmpeg 25.2MB 随包剔除，发布体积 -~50MB 压缩后） -->
  </ItemGroup>

  <ItemGroup>
    <!-- PP-OCRv6-small 多语言识别模型（简繁英日，约 35MB）。
         默认：单文件发布时随 IncludeAllContentForSelfExtract 内嵌进 exe（一个文件拷走就能用）。
         瘦身发布：dotnet publish ... -p:ExternalModels=true → models 输出为 exe 同级的 models\
         目录，exe 约小 30MB；运行时按需从 R2 下载（见 ModelPack）。 -->
    <Content Include="models\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile Condition="'$(ExternalModels)' == 'true'">true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EfootballBot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置 ViGEmBus 1.22.0 官方三架构安装器（离线安装，Advanced Installer 打包）：
         DriverPayload 释放 + SHA256 校验 + DriverInstaller 静默安装，用户机器无需手动装驱动 -->
    <EmbeddedResource Include="..\..\assets\ViGEmBusSetup.exe">
      <LogicalName>EfootballBot.ViGEmBusSetup.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- RapidOcrNet 的 build target 在 Publish 后无条件把 models/v5 松散复制到发布目录。
       默认（内嵌模型）：单文件发布删除这份松散副本，保证输出目录只有一个 exe。
       瘦身发布（-p:ExternalModels=true）：保留 models\ 目录，与 88MB 的 exe 一起分发
       （模型不随 exe 更新，日常升级只需下 exe）。 -->
  <Target Name="RemoveDuplicateV5ModelsFromSingleFile" AfterTargets="CopyModelsPublish"
          Condition="'$(PublishSingleFile)' == 'true' and '$(ExternalModels)' != 'true'">
    <RemoveDir Directories="$(PublishDir)models" Condition="Exists('$(PublishDir)models')" />
  </Target>

</Project>
