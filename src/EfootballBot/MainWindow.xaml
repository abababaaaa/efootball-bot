                                <Run Text="服务端风险面" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                <Run Text="：真实封号风险来自"/>
                                <Run Text="服务端行为检测" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                <Run Text="（7×24 在线、恒定操作节奏），与窗口怎么放、怎么输入无关。"/>
                                <Run Text="建议保持开启" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="。"/>
                            </TextBlock>

                            <!-- 后台停靠 -->
                            <CheckBox x:Name="ChkBackgroundParking" FontWeight="SemiBold" Margin="0,14,0,0"
                                      Content="后台停靠：挂机时把游戏窗口移出屏幕"/>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="520" Margin="28,4,0,0">
                                <Run Text="开始挂机后把游戏窗口"/>
                                <Run Text="整体移到屏幕之外" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="：完全看不到、误点不跳出；停止挂机"/>
                                <Run Text="自动还原原位置" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="（异常退出也会在下次启动时还原），游戏自己挪回也会被移出。"/>
