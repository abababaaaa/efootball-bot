                            <TextBlock Text="从暂停恢复继续挂机。"
                                       Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"
                                       MaxWidth="520" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- ============ 二级页：画面与性能 ============ -->
                    <StackPanel x:Name="SetTabDisplay" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
