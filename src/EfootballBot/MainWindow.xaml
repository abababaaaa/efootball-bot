                                     TextWrapping="Wrap" FontSize="11.5"
                                     Background="{DynamicResource Surface2}" BorderBrush="#33FFFFFF"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnDiagReport" Content="生成反馈包" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Click="BtnDiagReport_Click"/>
                                <Button x:Name="BtnOpenDiagFolder" Content="打开报告目录" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Margin="10,0,0,0" Click="BtnOpenDiagFolder_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDiagStatus" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== 声明 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
