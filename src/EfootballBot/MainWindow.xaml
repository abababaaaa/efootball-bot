                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,11">
                                <Run Text="本软件仅供学习交流与个人使用。使用自动化工具"/>
                                <Run Text="存在被官方封号的风险" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
