                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="手柄隔离" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap">
                                <Run Text="开启后机器人虚拟手柄"/>
                                <Run Text="仅游戏内可见" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="：Steam 与其他游戏收不到机器人按键。基于 HidHide 过滤驱动，首次开启自动安装并需"/>
                                <Run Text="管理员授权一次" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
