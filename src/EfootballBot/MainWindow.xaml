                                          Checked="ChkAutoSwapMaxLevel_Checked"
                                          ToolTip="每 N 场比赛结束后自动打开比赛计划巡检首发 11 人：满级（等级 x/x）球员自动分配能力点（已用完则跳过），并从后备球员换入整体评价最低的色卡球员；替补球员不参与">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★ " Foreground="{DynamicResource Warning}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="满级自动换人" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <ComboBox x:Name="CmbAutoSwapEvery" Width="86" Margin="12,0,0,0" SelectedIndex="3"
                                          VerticalAlignment="Center"
                                          ToolTip="每 N 场比赛结束后触发一次满级巡检换人">
