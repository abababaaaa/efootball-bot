                                <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                            <Ellipse Grid.Row="0" Style="{StaticResource BulletDot}"/>
