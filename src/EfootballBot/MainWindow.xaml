<Window x:Class="EfootballBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eFootball 挂机助手（手柄后台版）" Height="720" Width="1180"
        Icon="app.ico"
        MinHeight="640" MinWidth="1020"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 横幅白色按钮 -->
        <Style x:Key="BannerBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF0B7A4E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="17,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE7FAF1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主题选择卡片（悬停轻微放大） -->
        <Style x:Key="ThemePickCard" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 卡片标题前的绿色小竖条 -->
        <Style x:Key="CardTitleBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3.5"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="RadiusX" Value="1.7"/>
            <Setter Property="Fill" Value="{DynamicResource AccentGlow}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="372"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左栏：深色导航轨道 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SideLeftBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="15,16">
                <!-- 底部：主题切换 -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="2,0,2,10"/>
                    <Button x:Name="BtnTheme" Style="{StaticResource NavToolBtn}"
                            Click="BtnTheme_Click" HorizontalAlignment="Stretch"
                            ToolTip="切换界面主题（暗色 / 亮色 / 深蓝）">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 3a9 9 0 1 0 0 18c.9 0 1.5-.8 1.3-1.6-.2-1 .6-1.9 1.6-1.9h1.5A3.6 3.6 0 0 0 21 13c0-5.2-4-8.8-9-8.8Z"/>
                            <TextBlock Text="主题外观" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <!-- 品牌 Logo -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,20">
                        <Border Width="38" Height="38" CornerRadius="11" Effect="{StaticResource AccentShadow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF3FE09D" Offset="0"/>
                                    <GradientStop Color="#FF0C9A61" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="1.4" Opacity="0.95"/>
                                <Path Data="M19,8 V28" Stroke="White" StrokeThickness="1.4" Opacity="0.95"/>
                                <Ellipse Width="2.8" Height="2.8" Fill="White"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="eFootball" FontSize="16.5" FontWeight="Bold"/>
                            <TextBlock Text="挂机助手 · 手柄后台版" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                            <TextBlock Text="by Dabao#1392" FontSize="10"
                                       Foreground="{DynamicResource AccentGlow}" Margin="0,3,0,0"
                                       Opacity="0.9"/>
                            <TextBlock Text="反馈群 1128646247" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 游戏模块 -->
                    <TextBlock Text="游戏模块" Style="{StaticResource SectionLabel}"/>
                    <RadioButton x:Name="RbCn" Style="{StaticResource ModuleRadio}"
                                 ToolTip="国服（网易实况足球在线，进程 eFootballOnline）"
                                 Checked="RbModule_Checked">
                        <StackPanel>
                            <TextBlock Text="国服" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="网易 · 实况足球在线" FontSize="10.5"
                                       Foreground="{DynamicResource NavDescFg}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbIntl" Style="{StaticResource ModuleRadio}" IsChecked="True"
                                 Checked="RbModule_Checked">
                        <StackPanel>
                            <TextBlock Text="国际服" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Steam PC 版" FontSize="10.5"
                                       Foreground="{DynamicResource NavDescFg}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 工具 -->
                    <TextBlock Text="工具" Style="{StaticResource SectionLabel}" Margin="4,14,0,8"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource NavToolBtn}" Click="BtnSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 8.6a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8Z M12 2.8v2.2 M12 19v2.2 M2.8 12h2.2 M19 12h2.2 M5.5 5.5l1.6 1.6 M16.9 16.9l1.6 1.6 M18.5 5.5l-1.6 1.6 M7.1 16.9l-1.6 1.6"/>
                            <TextBlock Text="设置" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnUpdate" Style="{StaticResource NavToolBtn}" Click="BtnUpdate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 3.5v10 M7.8 9.6L12 13.8l4.2-4.2 M4.5 18.5h15"/>
                            <TextBlock Text="更新" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLogViewer" Style="{StaticResource NavToolBtn}" Click="BtnLogViewer_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M5.5 4h13v16h-13Z M9 8.5h6 M9 12h6 M9 15.5h4"/>
                            <TextBlock Text="日志历史" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnGraph" Style="{StaticResource NavToolBtn}" Click="BtnGraph_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="15" Height="15">
                                <Path Stretch="Uniform" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M9 7.2h6 M7.2 9v6 M9 16.8h6"/>
                                <Path Stretch="Uniform"
                                      Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M9.2 7.2a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z M18.8 7.2a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z M18.8 16.8a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"/>
                            </Grid>
                            <TextBlock Text="图谱" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- 环境检测 -->
                    <TextBlock Text="环境检测" Style="{StaticResource SectionLabel}" Margin="4,16,0,8"/>
                    <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="11,9">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotVigem" Width="8" Height="8" Fill="{DynamicResource ModuleDot}"
                                         Margin="1,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ViGEmBus 驱动" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotWgc" Width="8" Height="8" Fill="{DynamicResource ModuleDot}"
                                         Margin="1,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="后台画面捕获" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotOcr" Width="8" Height="8" Fill="{DynamicResource ModuleDot}"
                                         Margin="1,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOcr" Text="OCR 语言" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotGame" Width="8" Height="8" Fill="{DynamicResource ModuleDot}"
                                         Margin="1,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtGame" Text="游戏窗口（国际服）" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <Button x:Name="BtnRecheck" Content="重新检测" Style="{StaticResource GhostBtn}"
                                    HorizontalAlignment="Left" Margin="1,9,0,0" Padding="11,4" FontSize="11"
                                    Click="BtnRecheck_Click"/>
                            <Button x:Name="BtnInstallVigem" Content="安装内置驱动" Style="{StaticResource GhostBtn}"
                                    HorizontalAlignment="Left" Margin="1,5,0,0" Padding="11,4" FontSize="11"
                                    Click="BtnInstallVigem_Click"
                                    ToolTip="使用内置安装包离线安装 ViGEmBus 驱动（需管理员授权，无需联网）"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 中栏：功能卡 + 日志卡 ============ -->
        <Grid Grid.Column="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 更新提醒横幅（有新版本时显示） -->
            <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
                    CornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                    BorderBrush="#5535D392" BorderThickness="1"
                    Effect="{StaticResource FloatShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF12B072" Offset="0"/>
                        <GradientStop Color="#FF0B8A58" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#33FFFFFF"
                                VerticalAlignment="Center" Margin="0,0,11,0">
                            <TextBlock Text="🎉" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="TxtUpdateBannerTitle" Text="发现新版本" FontWeight="Bold" Foreground="White" FontSize="13"/>
                            <TextBlock x:Name="TxtUpdateBannerDesc" Text="" Foreground="#E6F8EF" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnBannerUpdate" Content="立即更新"
                            Style="{StaticResource BannerBtn}" VerticalAlignment="Center"
                            Click="BtnBannerUpdate_Click"/>
                </Grid>
            </Border>

            <!-- 国际服功能分段（国服时隐藏） -->
            <Border x:Name="IntlTabsBar" Grid.Row="1" HorizontalAlignment="Left" Margin="1,0,0,12"
                    Background="{DynamicResource TrackBg}" CornerRadius="10" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabLeague" Content="我的联赛" Style="{StaticResource SegTab}"
                                 Margin="0,0,2,0" IsChecked="True" Checked="IntlTab_Checked"/>
                    <RadioButton x:Name="TabWeekly" Content="周活动" Style="{StaticResource SegTab}"
                                 Checked="IntlTab_Checked"/>
                </StackPanel>
            </Border>

            <!-- 国服功能分段（国服时可见） -->
            <Border x:Name="CnTabsBar" Grid.Row="1" HorizontalAlignment="Left" Margin="1,0,0,12"
                    Visibility="Collapsed"
                    Background="{DynamicResource TrackBg}" CornerRadius="10" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabCnTour" Content="巡回赛" Style="{StaticResource SegTab}"
                                 IsChecked="True"/>
                </StackPanel>
            </Border>

            <!-- ===== 国际服功能卡（三 Pane 叠放） ===== -->
            <Border x:Name="PanelIntl" Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <!-- 我的联赛 -->
                    <Grid x:Name="PaneLeague">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentGlow}"
                                         VerticalAlignment="Center" Margin="0,0,9,1"/>
                                <TextBlock Text="我的联赛" FontSize="16.5" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="自动进出我的联赛，AI 代打，可自动购买联赛道具"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,9,0,0"/>
                            <StackPanel Margin="0,16,0,0">
                                <CheckBox x:Name="ChkOnlyKey" Content="只踢关键比赛（未实现）" IsChecked="False" IsEnabled="False"/>
                                <CheckBox x:Name="ChkBuy4x" Content="自动购买 4 倍经验道具" IsChecked="False"/>
                                <CheckBox x:Name="ChkBuyCond" Content="自动购买杰出状态道具" IsChecked="False"/>
                                <CheckBox x:Name="ChkBuyMgr" Content="自动购买教练强化道具" IsChecked="False"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="目标场次（0=不限）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtTarget" Width="68" Margin="10,0,0,0" Text="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="比赛难度" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbDifficulty" Width="116" Margin="10,0,0,0" SelectedIndex="6">
                                        <ComboBoxItem Content="新手"/>
                                        <ComboBoxItem Content="业余"/>
                                        <ComboBoxItem Content="标准"/>
                                        <ComboBoxItem Content="职业"/>
                                        <ComboBoxItem Content="顶尖球员"/>
                                        <ComboBoxItem Content="超级球星"/>
                                        <ComboBoxItem Content="传奇"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="{DynamicResource Surface2}" CornerRadius="7"
                                    HorizontalAlignment="Left" Margin="0,18,0,0" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="停止热键" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLeagueHotkey" Text="Ctrl+Shift+Q"
                                               Foreground="{DynamicResource AccentGlow}" FontSize="11"
                                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button x:Name="BtnMyLeague" Grid.Column="1" Content="开始"
                                Style="{StaticResource PrimaryBtn}" Width="104" Height="40" FontSize="14"
                                VerticalAlignment="Top" Margin="16,4,0,0" Click="BtnMyLeague_Click"/>
                    </Grid>

                    <!-- 周活动 -->
                    <Grid x:Name="PaneWeekly" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#FFA05AE0"
                                         VerticalAlignment="Center" Margin="0,0,9,1"/>
                                <TextBlock Text="周活动" FontSize="16.5" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="自动进入对阵AI，从最左逐个清挑战/巡回活动；巡回赛自动设置赛事等级、自动控制开、弹性关"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,9,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="赛事等级" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbWeeklyDiff" Width="116" Margin="10,0,0,0" SelectedIndex="6">
                                    <ComboBoxItem Content="新手"/>
                                    <ComboBoxItem Content="业余"/>
                                    <ComboBoxItem Content="标准"/>
                                    <ComboBoxItem Content="职业"/>
                                    <ComboBoxItem Content="顶尖球员"/>
                                    <ComboBoxItem Content="超级球星"/>
                                    <ComboBoxItem Content="传奇"/>
                                </ComboBox>
                            </StackPanel>
                            <Border Background="{DynamicResource Surface2}" CornerRadius="7"
                                    HorizontalAlignment="Left" Margin="0,18,0,0" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="停止热键" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWeeklyHotkey" Text="Ctrl+Shift+Q"
                                               Foreground="{DynamicResource AccentGlow}" FontSize="11"
                                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button x:Name="BtnWeekly" Grid.Column="1" Content="开始"
                                Style="{StaticResource PrimaryBtn}" Width="104" Height="40" FontSize="14"
                                VerticalAlignment="Top" Margin="16,4,0,0" Click="BtnWeekly_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 国服面板 ===== -->
            <Border x:Name="PanelCn" Grid.Row="2" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                <StackPanel>
                    <!-- 巡回赛功能 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#FFE0A14C"
                                         VerticalAlignment="Center" Margin="0,0,9,1"/>
                                <TextBlock Text="国服巡回赛" FontSize="16.5" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="自动进入比赛活动 → 对阵电脑巡回赛，难度继承上次，循环刷赛"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,9,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="场次上限（0=不限）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCnDailyLoop" Width="68" Margin="10,0,0,0" Text="0"/>
                            </StackPanel>
                            <Border Background="{DynamicResource Surface2}" CornerRadius="7"
                                    HorizontalAlignment="Left" Margin="0,18,0,0" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="停止热键" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCnHotkey" Text="Ctrl+Shift+Q"
                                               Foreground="{DynamicResource AccentGlow}" FontSize="11"
                                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button x:Name="BtnCnDaily" Grid.Column="1" Content="开始"
                                Style="{StaticResource PrimaryBtn}" Width="104" Height="40" FontSize="14"
                                VerticalAlignment="Top" Margin="16,4,0,0" Click="BtnCnDaily_Click"/>
                    </Grid>

                    <!-- 使用提示（内嵌凹槽卡） -->
                    <Border Style="{StaticResource Inset}" Margin="0,18,0,0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="国服使用提示" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,9"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" LineHeight="19">
                                1. 先启动国服「实况足球在线」并进入游戏主界面，再点开始。&#x0a;
                                2. 开始前请断开真实手柄（拔出接收器/蓝牙断开），否则虚拟手柄只能当玩家2，菜单不响应。&#x0a;
                                3. 手柄输入 + 后台捕获：游戏窗口无需置顶。&#x0a;
                                4. 首次使用请确认左侧 ViGEmBus 驱动灯为绿色。&#x0a;
                                5. 游戏语言需为简体中文。&#x0a;
                                6. 国服流程为初版，卡住时请把日志与预览截图反馈以便校准。
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 设置面板 ===== -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <StackPanel>
                                    <TextBlock Text="全局停止热键" Style="{StaticResource H2}"/>
                                    <TextBlock Text="游戏全屏时也能快速停止机器人" Foreground="{DynamicResource TextMuted}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <CheckBox x:Name="ChkHotkeyEnabled" Content="启用全局停止热键" IsChecked="True"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="修饰键" Style="{StaticResource FieldLabel}" Width="60"/>
                                <CheckBox x:Name="ChkHotkeyCtrl" Style="{StaticResource CheckTick}" Content="Ctrl" IsChecked="True" Margin="4,0,14,0"/>
                                <CheckBox x:Name="ChkHotkeyShift" Style="{StaticResource CheckTick}" Content="Shift" IsChecked="True" Margin="4,0,14,0"/>
                                <CheckBox x:Name="ChkHotkeyAlt" Style="{StaticResource CheckTick}" Content="Alt" Margin="4,0,14,0"/>
                                <CheckBox x:Name="ChkHotkeyWin" Style="{StaticResource CheckTick}" Content="Win" Margin="4,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="主键" Style="{StaticResource FieldLabel}" Width="60"/>
                                <TextBox x:Name="TxtHotkey" Width="140" IsReadOnly="True"
                                         Text="Q" Padding="8,4" FontSize="13"
                                         KeyDown="TxtHotkey_KeyDown" PreviewKeyDown="TxtHotkey_PreviewKeyDown"/>
                                <TextBlock Text="（点击后按键捕获）" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>

                            <Border Background="{DynamicResource Surface2}" CornerRadius="7"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="当前热键" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHotkeyPreview" Text="Ctrl+Shift+Q"
                                               Foreground="{DynamicResource AccentGlow}" FontSize="11.5"
                                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="结束行为" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoClose" Content="全部流程完毕后自动关闭程序" IsChecked="False"/>
                            <CheckBox x:Name="ChkMinimizeTray" Content="结束后最小化到托盘（暂未实现）" IsChecked="False" IsEnabled="False" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="性能 / 内存" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="画面捕获方式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbCaptureMode" Width="240" Margin="10,0,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="WGC 窗口捕获（后台挂机，推荐）"/>
                                    <ComboBoxItem Content="DXGI 桌面复制（更快，但窗口须可见）"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,9"
                                       Text="WGC 是 Windows 官方窗口专属捕获（Discord/Teams/OBS 同款），游戏被遮挡、你在操作其他程序时照常挂机；DXGI 直接读显卡桌面画面、高分辨率略快，但窗口不能被遮挡或最小化。建议游戏设为无边框窗口模式。更改在下次开始挂机时生效。"/>
                            <CheckBox x:Name="ChkPeriodicGc" Content="挂机期间定期强制 GC（每 5 分钟）" IsChecked="True"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="OCR 识别引擎" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbOcrEngine" Width="280" Margin="10,0,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="RapidOCR PP-OCRv6（精准，推荐）"/>
                                    <ComboBoxItem Content="Windows 内置 OCR（更快，回退用）"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,9"
                                       Text="PP-OCRv6 是随程序自带的离线深度学习模型（约 30MB，不联网、不装第三方软件），对游戏美术字、小号说明文字、繁简英日混排的识别显著优于 Windows OCR；代价是全屏识别约 0.3~0.5 秒。若新引擎在你的机器上异常，可随时切回 Windows OCR。更改在下次开始挂机时生效。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="OCR 识别频率" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbOcrInterval" Width="116" Margin="10,0,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="500 ms"/>
                                    <ComboBoxItem Content="900 ms"/>
                                    <ComboBoxItem Content="1500 ms"/>
                                    <ComboBoxItem Content="2500 ms"/>
                                    <ComboBoxItem Content="5000 ms"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="预览刷新间隔" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbPreviewInterval" Width="116" Margin="10,0,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="150 ms"/>
                                    <ComboBoxItem Content="300 ms"/>
                                    <ComboBoxItem Content="500 ms"/>
                                    <ComboBoxItem Content="1000 ms"/>
                                    <ComboBoxItem Content="2000 ms"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== 手柄隔离 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="手柄隔离" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                       Text="开启后机器人虚拟手柄对其他应用隐藏（Steam、其他游戏收不到机器人按键），仅游戏进程可见。基于 Nefarius HidHide 过滤驱动，首次开启自动安装并需管理员授权一次。"/>

                            <CheckBox x:Name="ChkHidHideEnabled" Content="虚拟手柄仅游戏内可见"
                                      Margin="0,12,0,0" FontWeight="SemiBold"
                                      Checked="ChkHidHideEnabled_Changed" Unchecked="ChkHidHideEnabled_Changed"/>
                            <TextBlock x:Name="TxtHidHideStatus" FontSize="11.5" Margin="28,4,0,0"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                       Text="正在检查状态…"/>

                            <CheckBox x:Name="ChkHidePhysical" FontWeight="SemiBold" Margin="0,10,0,0"
                                      Checked="ChkHidePhysical_Changed" Unchecked="ChkHidePhysical_Changed">
                                <StackPanel>
                                    <TextBlock Text="同时隐藏真实手柄" FontSize="12.5"/>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" MaxWidth="520" Margin="0,3,0,0"
                                               Text="HID 层应用（joy.cpl / DirectInput / 其他游戏启动器）看不到真实手柄；原生 XInput 应用不受影响。下次启动挂机时生效。"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <StackPanel>
                                    <TextBlock Text="挂机节奏" Style="{StaticResource H2}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                               Text="比赛中轻按 A、赛后弹窗确认的随机间隔区间"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Text="越小点得越勤，越大越像真人偶尔操作；必须立即响应的按钮不受此设置影响。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="最小" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtIdleMin" Width="68" Margin="9,0,0,0" Text="1"
                                         TextChanged="IdleTap_TextChanged"/>
                                <TextBlock Text="秒" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>
                                <TextBlock Text="最大" Style="{StaticResource FieldLabel}" Margin="20,0,0,0"/>
                                <TextBox x:Name="TxtIdleMax" Width="68" Margin="9,0,0,0" Text="4"
                                         TextChanged="IdleTap_TextChanged"/>
                                <TextBlock Text="秒" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtIdleError" Foreground="{DynamicResource Danger}" FontSize="11.5"
                                       Margin="0,9,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="日志" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkFileLog" Content="启用文件日志（写入 logs\ 目录）" IsChecked="True"/>
                            <CheckBox x:Name="ChkShowRuntimeLog" Content="显示底部运行日志卡" IsChecked="True" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="保留数量" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtMaxLogFiles" Width="56" Margin="8,0,0,0" Text="10"/>
                                <TextBlock Text="个 / 超" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
                                <TextBox x:Name="TxtLogRetentionDays" Width="56" Margin="8,0,0,0" Text="7"/>
                                <TextBlock Text="天自动清理（.yml 记事本可开）" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="文件日志级别" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbFileLogLevel" Width="116" Margin="10,0,0,0" SelectedIndex="3">
                                    <ComboBoxItem Content="Info"/>
                                    <ComboBoxItem Content="Warn"/>
                                    <ComboBoxItem Content="Error"/>
                                    <ComboBoxItem Content="Debug"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnOpenLogFolder" Content="打开日志文件夹" Style="{StaticResource GhostBtn}"
                                        Padding="13,6" Click="BtnOpenLogFolder_Click"/>
                                <TextBlock Text="所有改动自动保存" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== 声明 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,2,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="声明" Style="{StaticResource H2}"/>
                            </StackPanel>

                            <TextBlock Text="分辨率建议" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="理论支持全分辨率，但强烈建议游戏以「窗口化 720p」运行。分辨率过高会导致后台捕获与 OCR 卡顿，影响挂机稳定性。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,11"/>

                            <TextBlock Text="封号风险" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="本软件仅供学习交流与个人使用。使用自动化工具存在被官方封号的风险，一切后果由使用者自行承担，与作者无关。自愿使用，风险自担。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,11"/>

                            <TextBlock Text="反馈交流" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="问题反馈与交流请加 QQ 群：1128646247。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,11"/>

                            <TextBlock Text="版权与分发" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="本软件无偿免费，禁止二次售卖、付费分发，禁止篡改或移除作者信息后重新发布。转载请注明作者 Dabao#1392。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 自动更新面板（独立） ===== -->
            <ScrollViewer x:Name="UpdatePanel" Grid.Row="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="自动更新" Style="{StaticResource H2}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="当前版本" Foreground="{DynamicResource TextMuted}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtCurrentVersion" Text="v1.1.0" Foreground="{DynamicResource AccentGlow}"
                                                   FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="8"
                                        Padding="12,9" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="GitHub 仓库" Foreground="{DynamicResource TextMuted}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtUpdateRepo" Text="abababaaaa/efootball-bot"
                                                   Foreground="{DynamicResource AccentGlow}" FontSize="12.5"
                                                   Margin="0,5,0,0" Cursor="Hand" ToolTip="打开仓库主页"
                                                   MouseLeftButtonUp="TxtUpdateRepo_MouseLeftButtonUp"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <CheckBox x:Name="ChkCheckOnStartup" Content="启动时自动检查更新" IsChecked="True" Margin="0,4,0,0"/>
                            <CheckBox x:Name="ChkIncludePrerelease" Content="包含测试版（pre-release）" IsChecked="False"/>
                            <CheckBox x:Name="ChkAutoDownloadInstall" Content="发现更新后自动下载安装" IsChecked="False"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnCheckUpdate" Content="检查更新" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Click="BtnCheckUpdate_Click"/>
                                <Button x:Name="BtnApplyUpdate" Content="立即更新" Style="{StaticResource PrimaryBtn}"
                                        Margin="10,0,0,0" IsEnabled="False" Click="BtnApplyUpdate_Click"/>
                            </StackPanel>

                            <ProgressBar x:Name="PbUpdate" Margin="0,12,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtUpdateStatus" Text="" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" Margin="0,8,0,0"/>

                            <Border Margin="0,14,0,0" Background="{DynamicResource Surface2}" CornerRadius="8"
                                    Padding="12" Visibility="Collapsed" x:Name="ChangelogBox">
                                <StackPanel>
                                    <TextBlock Text="更新日志" Foreground="{DynamicResource AccentGlow}" FontSize="12"
                                               FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtChangelog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" MaxHeight="200"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                             Cursor="Arrow"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== 网络优化（GitHub 直连） ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="9" Height="9" Fill="#FF4FA8E0" VerticalAlignment="Center" Margin="0,0,9,1"/>
                                <TextBlock Text="网络优化" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="若 GitHub 无法直连导致检查更新或下载失败，可一键将 GitHub 域名指向测速最快的 IP（修改 hosts）。"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,9,0,0"/>
                            <Button x:Name="BtnOptimizeGitHub" Content="一键优化 GitHub 直连" Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="BtnOptimizeGitHub_Click"/>
                            <ProgressBar x:Name="PbGitHub" Margin="0,12,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtGitHubStatus" Text="" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 历史日志查看器 ===== -->
            <Border x:Name="LogViewerPanel" Grid.Row="2" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Style="{StaticResource CardTitleBar}"/>
                            <TextBlock Text="日志历史" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbLogFiles" Width="280" Margin="14,0,0,0"
                                      SelectionChanged="CmbLogFiles_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnRefreshLogs" Content="刷新" Style="{StaticResource GhostBtn}"
                                    Padding="11,4" FontSize="11" Click="BtnRefreshLogs_Click"/>
                            <Button x:Name="BtnOpenLogFolder2" Content="打开文件夹" Style="{StaticResource GhostBtn}"
                                    Padding="11,4" FontSize="11" Margin="8,0,0,0" Click="BtnOpenLogFolder_Click"/>
                            <Button x:Name="BtnDeleteLog" Content="删除选中" Style="{StaticResource GhostBtn}"
                                    Padding="11,4" FontSize="11" Margin="8,0,0,0" Click="BtnDeleteLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 日志内容 -->
                    <Border Grid.Row="1" Style="{StaticResource Inset}" Margin="0,10,0,0">
                        <ListBox x:Name="LogFileContent" Background="Transparent" BorderThickness="0"
                                 Margin="6" FontFamily="Consolas" FontSize="11.5"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5,1.5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- 状态栏 -->
                    <Grid Grid.Row="2" Margin="2,8,0,0">
                        <TextBlock x:Name="LogFileStatus" Text="—" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 日志卡（两套面板共用） ===== -->
            <Border x:Name="LogCard" Style="{StaticResource Card}" Grid.Row="3" Margin="0,12,0,0" Height="248">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Rectangle Width="7" Height="7" RadiusX="3.5" Fill="{DynamicResource AccentGlow}"
                                       VerticalAlignment="Center" Margin="1,0,8,0"/>
                            <TextBlock Text="运行日志" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="仅显示最近 300 条，详情看 log 日志"
                                   FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="清空" Style="{StaticResource GhostBtn}"
                                Padding="11,4" FontSize="11" Click="BtnClearLog_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Inset}" Margin="0,9,0,0">
                        <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                 Margin="6" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5,1.5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 右栏：实时辅助栏 ============ -->
        <Border Grid.Column="2" Background="{DynamicResource SideRightBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,18">
                    <!-- 实时画面 -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="实时画面" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnPreview" Content="开启预览" Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Right" Padding="11,4" FontSize="11"
                                Click="BtnPreview_Click"/>
                    </Grid>
                    <Border Background="{DynamicResource PreviewBg}" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Height="196" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="Preview" Stretch="Uniform"/>
                            <!-- 无信号占位（Preview.Source 为空时自动出现） -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source,ElementName=Preview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Width="34" Height="34" HorizontalAlignment="Center" Opacity="0.5">
                                    <Path Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M4 7h26v18H4Z M12 29h10 M17 25v4"/>
                                    <Path Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          Data="M6 5 L29 28"/>
                                </Grid>
                                <TextBlock Text="预览未开启" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <!-- 当前画面状态芯片 -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="8,0,8,8" Background="#CC0B0F14" CornerRadius="6" Padding="8,4">
                                <TextBlock x:Name="TxtScreen" Text="当前画面：—" Foreground="#FFDCE3EC"
                                           FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 统计：指标格 -->
                    <TextBlock Text="统计" Style="{StaticResource H2}" Margin="0,22,0,11"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Surface2}"
                                CornerRadius="10" Padding="13,11" Margin="0,0,5,10">
                            <StackPanel>
                                <TextBlock x:Name="StMatches" Text="0" FontSize="23" FontWeight="Bold"/>
                                <TextBlock Text="完成场次" Foreground="{DynamicResource TextMuted}"
                                           FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Surface2}"
                                CornerRadius="10" Padding="13,11" Margin="5,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="StKey" Text="0" FontSize="23" FontWeight="Bold"/>
                                <TextBlock Text="关键比赛" Foreground="{DynamicResource TextMuted}"
                                           FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Surface2}"
                                CornerRadius="10" Padding="13,11" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock x:Name="StForfeit" Text="0" FontSize="23" FontWeight="Bold"/>
                                <TextBlock Text="弃权场次" Foreground="{DynamicResource TextMuted}"
                                           FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Surface2}"
                                CornerRadius="10" Padding="13,11" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="StElapsed" Text="—" FontSize="23" FontWeight="Bold"/>
                                <TextBlock Text="运行时长" Foreground="{DynamicResource TextMuted}"
                                           FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="StError" Foreground="{DynamicResource Danger}" FontSize="11"
                               TextWrapping="Wrap" Margin="2,10,0,0"/>

                    <!-- 使用提示 -->
                    <TextBlock Text="使用提示" Style="{StaticResource H2}" Margin="0,22,0,10"/>
                    <Border Style="{StaticResource Inset}" Padding="14,12">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" LineHeight="19">
                            1. 手柄输入 + 后台捕获：游戏窗口无需置顶，可最小化干活去。&#x0a;
                            2. 首次使用先点「安装 ViGEmBus 驱动」，装完重启本程序。&#x0a;
                            3. 游戏内建议：小窗口、100 FPS、选手操作设为 AI、难度与上方选择一致。&#x0a;
                            4. 游戏语言需为简体中文（OCR 以中文识别为主）。
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== 主题选择覆盖层（首次启动 / 手动触发） ===== -->
        <Border x:Name="ThemeOverlay" Grid.ColumnSpan="3" Background="{DynamicResource Scrim}"
                Visibility="Collapsed" Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="34,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource FloatShadow}">
                <StackPanel>
                    <TextBlock Text="选择您的主题" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="您可以通过左侧栏底部的「主题外观」随时更改" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,5,0,24"/>

                    <!-- 主题卡片 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- 暗色 -->
                        <Border x:Name="CardDark" Style="{StaticResource ThemePickCard}" CornerRadius="12"
                                Padding="3" Margin="7" Background="{DynamicResource AccentLight}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                MouseLeftButtonUp="ThemeCard_Click" Tag="Dark">
                            <StackPanel>
                                <Border CornerRadius="9" Width="168" Height="104" Background="#FF0C1015"
                                        BorderBrush="#FF242D3A" BorderThickness="1" Padding="9">
                                    <Grid>
                                        <Rectangle Width="32" Height="80" Fill="#FF080B0F" RadiusX="3" RadiusY="3"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Rectangle Width="3" Height="18" Fill="#FF0FA968" RadiusX="1.5"
                                                   HorizontalAlignment="Left" Margin="0,10" VerticalAlignment="Top"/>
                                        <StackPanel Margin="41,3,0,0">
                                            <Rectangle Height="6" Width="82" Fill="#FFECF1F7" RadiusX="3" RadiusY="3" Margin="0,0,0,7"/>
                                            <Rectangle Height="4" Width="62" Fill="#FF6C7686" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="72" Fill="#FF6C7686" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="56" Fill="#FF6C7686" RadiusX="2" RadiusY="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="暗色" FontSize="12.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 亮色 -->
                        <Border x:Name="CardLight" Style="{StaticResource ThemePickCard}" CornerRadius="12"
                                Padding="3" Margin="7" Background="Transparent"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="2"
                                MouseLeftButtonUp="ThemeCard_Click" Tag="Light">
                            <StackPanel>
                                <Border CornerRadius="9" Width="168" Height="104" Background="#FFEDF0F4"
                                        BorderBrush="#FFDDE3EA" BorderThickness="1" Padding="9">
                                    <Grid>
                                        <Rectangle Width="32" Height="80" Fill="#FFF7F9FB" RadiusX="3" RadiusY="3"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Rectangle Width="3" Height="18" Fill="#FF0B8F5B" RadiusX="1.5"
                                                   HorizontalAlignment="Left" Margin="0,10" VerticalAlignment="Top"/>
                                        <StackPanel Margin="41,3,0,0">
                                            <Rectangle Height="6" Width="82" Fill="#FF151A21" RadiusX="3" RadiusY="3" Margin="0,0,0,7"/>
                                            <Rectangle Height="4" Width="62" Fill="#FF8C97A6" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="72" Fill="#FF8C97A6" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="56" Fill="#FF8C97A6" RadiusX="2" RadiusY="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="亮色" FontSize="12.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 深蓝 -->
                        <Border x:Name="CardDeepBlue" Style="{StaticResource ThemePickCard}" CornerRadius="12"
                                Padding="3" Margin="7" Background="Transparent"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="2"
                                MouseLeftButtonUp="ThemeCard_Click" Tag="DeepBlue">
                            <StackPanel>
                                <Border CornerRadius="9" Width="168" Height="104" Background="#FF081221"
                                        BorderBrush="#FF1E3350" BorderThickness="1" Padding="9">
                                    <Grid>
                                        <Rectangle Width="32" Height="80" Fill="#FF060D19" RadiusX="3" RadiusY="3"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Rectangle Width="3" Height="18" Fill="#FF2F94C9" RadiusX="1.5"
                                                   HorizontalAlignment="Left" Margin="0,10" VerticalAlignment="Top"/>
                                        <StackPanel Margin="41,3,0,0">
                                            <Rectangle Height="6" Width="82" Fill="#FFDFE9F4" RadiusX="3" RadiusY="3" Margin="0,0,0,7"/>
                                            <Rectangle Height="4" Width="62" Fill="#FF5D7EA3" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="72" Fill="#FF5D7EA3" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="56" Fill="#FF5D7EA3" RadiusX="2" RadiusY="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="深蓝" FontSize="12.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 确认按钮 -->
                    <Button x:Name="BtnThemeConfirm" Content="继续" Style="{StaticResource PrimaryBtn}"
                            Width="200" Height="40" Margin="0,26,0,0" HorizontalAlignment="Center"
                            Click="BtnThemeConfirm_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
