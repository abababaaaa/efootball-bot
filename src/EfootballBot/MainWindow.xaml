                                     IsChecked="True" Checked="SettingsTab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="★" Foreground="{DynamicResource Warning}" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="重要设定" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbSetDisplay" GroupName="SettingsNav" Style="{StaticResource SettingsTabRadio}"
                                     Content="画面与性能" Checked="SettingsTab_Checked"/>
                        <RadioButton x:Name="RbSetInput" GroupName="SettingsNav" Style="{StaticResource SettingsTabRadio}"
                                     Content="手柄与输入" Checked="SettingsTab_Checked"/>
                        <RadioButton x:Name="RbSetDaily" GroupName="SettingsNav" Style="{StaticResource SettingsTabRadio}"
                                     Content="挂机与日志" Checked="SettingsTab_Checked"/>
                        <RadioButton x:Name="RbSetDev" GroupName="SettingsNav" Style="{StaticResource SettingsTabRadio}"
                                     Content="开发者选项" Checked="SettingsTab_Checked"
                                     ToolTip="训练数据采集等面向开发调试的功能，普通用户无需改动"/>
                    </StackPanel>

                    <!-- ============ 二级页：★ 重要设定（防检测 + 热键） ============ -->
                    <StackPanel x:Name="SetTabImportant">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Style="{StaticResource H2}"><Run Text="★ " Foreground="{DynamicResource Warning}"/>防检测保护</TextBlock>
                            </StackPanel>
