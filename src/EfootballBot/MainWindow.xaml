                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BulletText}"><Run Text="本地代理接管 GitHub 全家（clone / push / Release / raw / 网页），"/><Run Text="内置真实 IP 表免疫 DNS 污染"/><Run Text="，其他网站流量不受影响"/></TextBlock>
                                <Ellipse Grid.Row="1" Style="{StaticResource BulletDot}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BulletText}"><Run Text="内核来自开源项目 gitport-github（"/><Run Text="约 8 MB"/><Run Text="），首次使用需下载一次；分流/PAC/镜像链开关在其工作台页面配置"/></TextBlock>
                                <Ellipse Grid.Row="2" Style="{StaticResource BulletDot}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BulletText}"><Run Text="停止或退出程序会结束内核；系统代理状态由内核退出时自动还原"/></TextBlock>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="BtnGitPortAction" Content="下载内核" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Click="BtnGitPortAction_Click"/>
                                <Button x:Name="BtnGitPortWorkbench" Content="打开工作台" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Margin="10,0,0,0" Click="BtnGitPortWorkbench_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="TxtGitPortStatus" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <Rectangle Style="{StaticResource Hairline}" Margin="0,12,0,10"/>
                            <TextBlock Text="GitHub 域名延迟" Style="{StaticResource SubHead}"/>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Text="先看这张表：GitHub 域名延迟都在 200ms 以上或大量无响应 = 该开加速了；打开加速后再测一遍对比。"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="BtnGithubMeasure" Content="测量 GitHub" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Click="BtnGithubMeasure_Click"/>
                                <TextBlock x:Name="TxtGithubSummary" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </WrapPanel>
                            <ListView x:Name="LvGithub" Height="196" FontSize="12.5" Margin="0,8,0,0"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource TextPrimary}"
                                      ItemContainerStyle="{StaticResource NetRowStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionMode="Single">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource NetHeaderStyle}">
                                        <GridViewColumn Header="域名" Width="190" DisplayMemberBinding="{Binding Label}"/>
                                        <GridViewColumn Header="IP" Width="115" DisplayMemberBinding="{Binding Ip}"/>
                                        <GridViewColumn Header="延迟" Width="95">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"
                                                                 Fill="{Binding DotBrush}"/>
                                                        <TextBlock Text="{Binding DelayText}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 网络监测面板（国际服服务器延迟 + 游戏内连接监控） ===== -->
            <ScrollViewer x:Name="NetworkPanel" Grid.Row="2" Visibility="Collapsed"
                          Style="{StaticResource PageScroll}">
                <Grid Margin="0,2,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <!-- ===== 国际服网络监测 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Style="{StaticResource H2}">国际服网络监测</TextBlock>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Text="内置 eFootball 服务器清单（游戏服走 ICMP、更新服/候选服走 TCP，与 ETK 工具同源）：测哪个服务器离你最近、当前能不能连。也可手动添加 IP。" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="BtnMeasureAll" Content="测量全部" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Click="BtnMeasureAll_Click"/>
                                <Button x:Name="BtnMeasureCancel" Content="取消" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Margin="10,0,0,0" Click="BtnMeasureCancel_Click" IsEnabled="False"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                           Margin="16,0,6,0" Text="只看 ≤"/>
                                <TextBox x:Name="TxtFilterMs" Width="52" Padding="4,3" FontSize="11.5" Text="150"
                                         Background="{DynamicResource Surface2}" BorderBrush="#33FFFFFF"
                                         TextChanged="TxtFilterMs_TextChanged"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                           Margin="4,0,12,0" Text="ms"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                           Margin="0,0,6,0" Text="筛选"/>
                                <TextBox x:Name="TxtServerFilter" Width="150" Padding="4,3" FontSize="11.5"
                                         Background="{DynamicResource Surface2}" BorderBrush="#33FFFFFF"
                                         TextChanged="TxtServerFilter_TextChanged"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                <Ellipse Width="7" Height="7" Fill="#FF3DDC84" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="&lt;60" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="&lt;150" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="高" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource EnvDotIdle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="无响应" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            </StackPanel>
                            <DataGrid x:Name="LvServers" MinHeight="200" Grid.Row="1" VerticalAlignment="Stretch" FontSize="12.5" HorizontalAlignment="Stretch"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                      Foreground="{DynamicResource TextPrimary}"
                                      RowHeight="27" ColumnHeaderHeight="28"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ColumnHeaderStyle="{StaticResource NetDataHeader}"
                                      CellStyle="{StaticResource NetDataCell}"
                                      RowStyle="{StaticResource NetDataRow}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="名称" Width="1.4*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                               Margin="8,0,0,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="IP" Width="1.1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Ip}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="类型" Width="0.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Kind}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="延迟" Width="0.9*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                 Margin="0,0,6,0" Fill="{Binding DotBrush}"/>
                                                        <TextBlock Text="{Binding DelayText}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            <StackPanel Grid.Row="2">
                            <WrapPanel Margin="0,8,0,0">
                                <TextBox x:Name="TxtAddTarget" Width="200" Padding="4,3" FontSize="11.5"
                                         Background="{DynamicResource Surface2}" BorderBrush="#33FFFFFF"
                                         KeyDown="TxtAddTarget_KeyDown"/>
                                <Button x:Name="BtnAddTarget" Content="添加 IP / 域名" Style="{StaticResource GhostBtn}"
                                        Padding="12,5" Margin="10,0,0,0" Click="BtnAddTarget_Click"/>
                                <Button x:Name="BtnRemoveTarget" Content="移除选中" Style="{StaticResource GhostBtn}"
                                        Padding="12,5" Margin="10,0,0,0" Click="BtnRemoveTarget_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="TxtServerSummary" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== 游戏内连接监控（Npcap 抓真实 UDP 连接 + 每秒 ping，可开悬浮窗） ===== -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Style="{StaticResource H2}">游戏内连接监控</TextBlock>
                                <Ellipse x:Name="DotInGame" Width="8" Height="8" Margin="12,0,6,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource EnvDotIdle}"/>
                                <TextBlock x:Name="TxtInGameState" Text="未启动" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Text="从游戏进程的真实 UDP 流量里认出比赛连接（Npcap 抓包，与 ETK 同一思路），每秒 ping 一次远端。开悬浮窗后可放在游戏画面上边打边看——延迟飙高/连续丢包就是这局要卡了。"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="BtnInGameMonitor" Content="启动监控" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Click="BtnInGameMonitor_Click"/>
                                <Button x:Name="BtnInGameOverlay" Content="显示悬浮窗" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Margin="10,0,0,0" Click="BtnInGameOverlay_Click"/>
                            </WrapPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtIgDelay" Text="—" FontSize="19" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="延迟" Foreground="{DynamicResource TextMuted}" FontSize="9.5" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtIgLoss" Text="—" FontSize="19" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="丢包" Foreground="{DynamicResource TextMuted}" FontSize="9.5" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource StatTile}" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtIgRemote" Text="—" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="远端地址" Foreground="{DynamicResource TextMuted}" FontSize="9.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource StatTile}" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtIgRegion" Text="—" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="区域" Foreground="{DynamicResource TextMuted}" FontSize="9.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Canvas x:Name="CvIgSpark" Height="64" Margin="0,10,0,4" ClipToBounds="True"/>
                            <TextBlock x:Name="TxtIgDetail" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,2,0,0" TextWrapping="Wrap" Text="点「启动监控」后，进比赛会自动认出服务器连接；每场结束自动追加 data\network\matchlog.csv。"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== 对战线路（强制 P2P / 更新服加速，均需管理员） ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Style="{StaticResource H2}">对战线路</TextBlock>
                                <Ellipse x:Name="DotP2P" Width="8" Height="8" Margin="12,0,6,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource EnvDotIdle}"/>
                                <TextBlock x:Name="TxtP2PState" Text="未启用" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Text="强制 P2P：屏蔽游戏到测速服务器的 UDP 端口（5521 / 10000 / 30000 / 50000），让匹配走点对点。匹配等待会明显变长，不想用随时关闭。规则写在 Windows 防火墙并绑定 eFootball.exe，删除即还原。更新服加速：给科乐美更新 CDN 选最快边缘 IP 写 hosts（可一键还原）。两项都需要以管理员身份运行本程序。"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="BtnP2PToggle" Content="启用强制 P2P" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Click="BtnP2PToggle_Click"/>
                                <CheckBox x:Name="ChkP2PTcp" Content="同时屏蔽 TCP 服务器模式" VerticalAlignment="Center"
                                          Margin="14,0,0,0" FontSize="11.5"/>
                                <Button x:Name="BtnUpdateHosts" Content="更新服测速加速" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Margin="18,0,0,0" Click="BtnUpdateHosts_Click"/>
                                <Button x:Name="BtnUpdateHostsRestore" Content="还原 hosts" Style="{StaticResource GhostBtn}"
                                        Padding="12,5" Margin="10,0,0,0" Click="BtnUpdateHostsRestore_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="TxtLineDetail" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ===== 自动更新面板（独立） ===== -->
            <ScrollViewer x:Name="UpdatePanel" Grid.Row="2" Visibility="Collapsed"
                          Style="{StaticResource PageScroll}">
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="自动更新" Style="{StaticResource H2}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12,9" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="当前版本" Foreground="{DynamicResource TextMuted}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtCurrentVersion" Text="v1.1.0" Foreground="{DynamicResource AccentGlow}"
                                                   FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="8"
                                        Padding="12,9" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="GitHub 仓库" Foreground="{DynamicResource TextMuted}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtUpdateRepo" Text="abababaaaa/efootball-bot"
                                                   Foreground="{DynamicResource AccentGlow}" FontSize="12"
                                                   Margin="0,5,0,0" Cursor="Hand" ToolTip="打开仓库主页"
                                                   MouseLeftButtonUp="TxtUpdateRepo_MouseLeftButtonUp"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface2}" CornerRadius="8"
                                        Padding="12,9" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="下载通道" Foreground="{DynamicResource TextMuted}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtUpdateChannel" Text="国内直连源 → 加速镜像 → GitHub，自动选路 + SHA256 完整性校验"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="10.5"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <CheckBox x:Name="ChkCheckOnStartup" Content="启动时自动检查更新" IsChecked="True" Margin="0,2,0,0"/>
                            <CheckBox x:Name="ChkIncludePrerelease" Content="包含测试版（pre-release）" IsChecked="False"/>
                            <CheckBox x:Name="ChkAutoDownloadInstall" Content="发现更新后自动下载安装" IsChecked="False"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnCheckUpdate" Content="检查更新" Style="{StaticResource GhostBtn}"
                                        Padding="14,7" Click="BtnCheckUpdate_Click"/>
                                <Button x:Name="BtnApplyUpdate" Content="立即更新" Style="{StaticResource PrimaryBtn}"
                                        Margin="10,0,0,0" IsEnabled="False" Click="BtnApplyUpdate_Click"/>
                            </StackPanel>

                            <ProgressBar x:Name="PbUpdate" Margin="0,10,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtUpdateStatus" Text="" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11.5" Margin="0,6,0,0"/>

                            <Border Margin="0,10,0,0" Background="{DynamicResource Surface2}" CornerRadius="8"
                                    Padding="12" Visibility="Collapsed" x:Name="ChangelogBox">
                                <StackPanel>
                                    <TextBlock Text="本次更新内容" Foreground="{DynamicResource AccentGlow}" FontSize="12"
                                               FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtChangelog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" MaxHeight="200"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                             Cursor="Arrow"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== 更新日志：内置全部历史版本（离线可查，不依赖联网） ===== -->
                    <Border Style="{StaticResource Card}" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="更新日志" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="程序内已内置每个版本的更新说明，不需要联网即可翻看。"
                                       Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="版本" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbChangelogVersion" Width="240" Margin="10,0,0,0"
                                          ToolTip="选择要查看的版本"
                                          SelectionChanged="CmbChangelogVersion_SelectionChanged"/>
                            </StackPanel>

                            <Border Grid.Row="3" Margin="0,10,0,0" Background="{DynamicResource Surface2}" CornerRadius="8"
                                    Padding="12" VerticalAlignment="Stretch">
                                <TextBox x:Name="TxtChangelogHistory" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         VerticalContentAlignment="Top"
                                         Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                         Cursor="Arrow"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ===== 历史日志查看器 ===== -->
            <Border x:Name="LogViewerPanel" Grid.Row="2" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏两行（★必须包在同一个行容器里：两行都直接放 Grid 会都落在 Row 0 叠在一起） -->
                    <StackPanel Grid.Row="0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Style="{StaticResource CardTitleBar}"/>
                            <TextBlock Text="日志历史" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnRefreshLogs" Content="刷新" Style="{StaticResource GhostBtn}"
                                    Height="26" Padding="11,0" FontSize="11.5" Click="BtnRefreshLogs_Click"/>
                            <Button x:Name="BtnOpenLogFolder2" Content="打开文件夹" Style="{StaticResource GhostBtn}"
                                    Height="26" Padding="11,0" FontSize="11.5" Margin="7,0,0,0" Click="BtnOpenLogFolder_Click"/>
                            <Button x:Name="BtnDeleteLog" Content="删除选中" Style="{StaticResource DangerOutlineBtn}"
                                    Height="26" Padding="11,0" FontSize="11.5" Margin="7,0,0,0" Click="BtnDeleteLog_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbLogFiles" Grid.Column="0" MinWidth="110" MaxWidth="320"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbLogFiles_SelectionChanged"/>
                        <ComboBox x:Name="CmbHistoryLogFilter" Grid.Column="1" Width="118" FontSize="11.5"
                                  Margin="8,0,0,0" VerticalAlignment="Center" SelectedIndex="0"
                                  ToolTip="历史日志显示过滤（文件内容不受影响，与运行日志同款三档）"
                                  SelectionChanged="CmbHistoryLogFilter_SelectionChanged">
                            <ComboBoxItem Content="全部"/>
                            <ComboBoxItem Content="仅关键流程"/>
                            <ComboBoxItem Content="仅报错/提醒"/>
                        </ComboBox>
                    </Grid>
                    </StackPanel>

                    <!-- 日志内容 -->
                    <Border Grid.Row="1" Style="{StaticResource Inset}" Margin="0,10,0,0">
                        <ListBox x:Name="LogFileContent" Background="Transparent" BorderThickness="0"
                                 Margin="6" FontFamily="Consolas" FontSize="11.5"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5,1.5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- 状态栏 -->
                    <Grid Grid.Row="2" Margin="2,8,0,0">
                        <TextBlock x:Name="LogFileStatus" Text="—" Foreground="{DynamicResource TextMuted}" FontSize="11.5"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
            </Grid>

        <!-- ============ 右栏：实时辅助栏（预览 + 紧凑统计 + 运行日志占满剩余） ============ -->
        <Border x:Name="RightPanel" Grid.Column="2" Background="{DynamicResource SideRightBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
            <Grid Margin="16,16,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 实时画面 -->
                <Grid Grid.Row="0" Margin="2,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="13" RadiusX="1.5" Fill="{DynamicResource AccentGlow}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="实时画面" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPreview" Content="开启预览" Style="{StaticResource GhostBtn}"
                                Height="26" Padding="10,0" FontSize="11.5"
                                Click="BtnPreview_Click"/>
                        <Button x:Name="BtnRightCollapse" Style="{StaticResource GhostBtn}" Height="26" Width="28"
                                Padding="0" Margin="7,0,0,0" ToolTip="收起右侧栏（中栏铺满）"
                                Click="BtnRightCollapse_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M9 5l7 7-7 7"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource PreviewBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="10" Height="196" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="Preview" Stretch="Uniform"/>
                        <!-- 无信号占位（Preview.Source 为空时自动出现） -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source,ElementName=Preview}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Width="30" Height="30" HorizontalAlignment="Center" Opacity="0.45">
                                <Path Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4 7h26v18H4Z M12 29h10 M17 25v4"/>
                                <Path Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      Data="M6 5 L29 28"/>
                            </Grid>
                            <TextBlock Text="预览未开启" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                        <!-- 当前画面状态芯片 -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="8,0,8,8" Background="#CC0B0F14" CornerRadius="6" Padding="8,3.5">
                            <TextBlock x:Name="TxtScreen" Text="当前画面：—" Foreground="#FFDCE3EC"
                                       FontSize="10.5"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 统计：紧凑四格（完成/关键/满级/时长） -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock x:Name="StMatches" Text="0" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="完成场次" Foreground="{DynamicResource TextMuted}" FontSize="9.5"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock x:Name="StKey" Text="0" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="关键比赛" Foreground="{DynamicResource TextMuted}" FontSize="9.5"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StatTile}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock x:Name="StMaxed" Text="0" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="球员满级" Foreground="{DynamicResource TextMuted}" FontSize="9.5"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource StatTile}" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="StElapsed" Text="—" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="运行时长" Foreground="{DynamicResource TextMuted}" FontSize="9.5"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- P2-20：最近错误可点击 → 切到运行日志的报错档，省掉用户自己找 -->
                    <TextBlock x:Name="StError" Foreground="{DynamicResource Danger}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="2,7,0,0" Cursor="Hand"
                               ToolTip="点击查看报错日志"
                               MouseLeftButtonUp="StError_Click"/>
                    <!-- 分段耗时（P1-14）：帧/OCR/YOLO/动作，1 分钟刷新一次；空串时不留空行 -->
                    <TextBlock x:Name="StPerf" Foreground="{DynamicResource TextMuted}" FontSize="10.5"
                               TextWrapping="Wrap" Margin="2,5,0,0" Text=""/>
                </StackPanel>

                <!-- 运行日志（占满剩余高度） -->
                <Grid x:Name="LogCard" Grid.Row="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="13" RadiusX="1.5" Fill="{DynamicResource AccentGlow}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="运行日志" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                            <ComboBox x:Name="CmbRuntimeLogFilter" Width="112" FontSize="11.5" Height="26"
                                      VerticalAlignment="Center" SelectedIndex="0"
                                      ToolTip="应用内日志显示过滤（文件日志始终全量）"
                                      SelectionChanged="CmbRuntimeLogFilter_SelectionChanged">
                                <ComboBoxItem Content="全部"/>
                                <ComboBoxItem Content="仅关键流程"/>
                                <ComboBoxItem Content="仅报错/提醒"/>
                            </ComboBox>
                            <Button Content="清空" Style="{StaticResource GhostBtn}"
                                    Height="26" Padding="11,0" FontSize="11.5" Margin="7,0,0,0"
                                    VerticalAlignment="Center" Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Inset}" Margin="0,9,0,0">
                        <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                 Margin="5,6,3,6" FontFamily="Consolas" FontSize="11.5"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 右侧折叠条：右栏收起后点它展开（中栏已铺满） ===== -->
        <Border x:Name="RightRail" Grid.Column="3" Width="30" Visibility="Collapsed"
                Background="{DynamicResource SideRightBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,1,0">
            <Button x:Name="BtnRightExpand" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="展开右侧栏（实时画面 / 统计 / 运行日志）" Click="BtnRightExpand_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center"
                          Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M15 5l-7 7 7 7"/>
                    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="实" FontSize="11.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="时" FontSize="11.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="画" FontSize="11.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="面" FontSize="11.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Border>

        <!-- ===== 主题选择覆盖层（首次启动 / 手动触发） ===== -->
        <Border x:Name="ThemeOverlay" Grid.ColumnSpan="4" Background="{DynamicResource Scrim}"
                Visibility="Collapsed" Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="16" Padding="34,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource FloatShadow}">
                <StackPanel>
                    <TextBlock Text="选择您的主题" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="您可以通过左侧栏底部的「主题外观」随时更改" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,5,0,24"/>

                    <!-- 主题卡片 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- 暗色 -->
                        <Border x:Name="CardDark" Style="{StaticResource ThemePickCard}" CornerRadius="12"
                                Padding="3" Margin="7" Background="{DynamicResource AccentLight}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                MouseLeftButtonUp="ThemeCard_Click" Tag="Dark">
                            <StackPanel>
                                <Border CornerRadius="9" Width="168" Height="104" Background="#FF0C1015"
                                        BorderBrush="#FF242D3A" BorderThickness="1" Padding="9">
                                    <Grid>
                                        <Rectangle Width="32" Height="80" Fill="#FF080B0F" RadiusX="3" RadiusY="3"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Rectangle Width="3" Height="18" Fill="#FF0FA968" RadiusX="1.5"
                                                   HorizontalAlignment="Left" Margin="0,10" VerticalAlignment="Top"/>
                                        <StackPanel Margin="41,3,0,0">
                                            <Rectangle Height="6" Width="82" Fill="#FFECF1F7" RadiusX="3" RadiusY="3" Margin="0,0,0,7"/>
                                            <Rectangle Height="4" Width="62" Fill="#FF6C7686" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="72" Fill="#FF6C7686" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="56" Fill="#FF6C7686" RadiusX="2" RadiusY="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="暗色" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 亮色 -->
                        <Border x:Name="CardLight" Style="{StaticResource ThemePickCard}" CornerRadius="12"
                                Padding="3" Margin="7" Background="Transparent"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="2"
                                MouseLeftButtonUp="ThemeCard_Click" Tag="Light">
                            <StackPanel>
                                <Border CornerRadius="9" Width="168" Height="104" Background="#FFEDF0F4"
                                        BorderBrush="#FFDDE3EA" BorderThickness="1" Padding="9">
                                    <Grid>
                                        <Rectangle Width="32" Height="80" Fill="#FFF7F9FB" RadiusX="3" RadiusY="3"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Rectangle Width="3" Height="18" Fill="#FF0B8F5B" RadiusX="1.5"
                                                   HorizontalAlignment="Left" Margin="0,10" VerticalAlignment="Top"/>
                                        <StackPanel Margin="41,3,0,0">
                                            <Rectangle Height="6" Width="82" Fill="#FF151A21" RadiusX="3" RadiusY="3" Margin="0,0,0,7"/>
                                            <Rectangle Height="4" Width="62" Fill="#FF8C97A6" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="72" Fill="#FF8C97A6" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="56" Fill="#FF8C97A6" RadiusX="2" RadiusY="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="亮色" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 深蓝 -->
                        <Border x:Name="CardDeepBlue" Style="{StaticResource ThemePickCard}" CornerRadius="12"
                                Padding="3" Margin="7" Background="Transparent"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="2"
                                MouseLeftButtonUp="ThemeCard_Click" Tag="DeepBlue">
                            <StackPanel>
                                <Border CornerRadius="9" Width="168" Height="104" Background="#FF081221"
                                        BorderBrush="#FF1E3350" BorderThickness="1" Padding="9">
                                    <Grid>
                                        <Rectangle Width="32" Height="80" Fill="#FF060D19" RadiusX="3" RadiusY="3"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Rectangle Width="3" Height="18" Fill="#FF2F94C9" RadiusX="1.5"
                                                   HorizontalAlignment="Left" Margin="0,10" VerticalAlignment="Top"/>
                                        <StackPanel Margin="41,3,0,0">
                                            <Rectangle Height="6" Width="82" Fill="#FFDFE9F4" RadiusX="3" RadiusY="3" Margin="0,0,0,7"/>
                                            <Rectangle Height="4" Width="62" Fill="#FF5D7EA3" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="72" Fill="#FF5D7EA3" RadiusX="2" RadiusY="2" Margin="0,0,0,5"/>
                                            <Rectangle Height="4" Width="56" Fill="#FF5D7EA3" RadiusX="2" RadiusY="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="深蓝" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 确认按钮 -->
                    <Button x:Name="BtnThemeConfirm" Content="继续" Style="{StaticResource PrimaryBtn}"
                            Width="200" Height="40" Margin="0,26,0,0" HorizontalAlignment="Center"
                            Click="BtnThemeConfirm_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Grid>
</ui:FluentWindow>
