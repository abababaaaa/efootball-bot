<ui:FluentWindow x:Class="EfootballBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Title="eFootball 挂机助手（手柄后台版）" Height="800" Width="1280"
        Icon="app.ico"
        MinHeight="640" MinWidth="1140"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 横幅白色按钮 -->
        <Style x:Key="BannerBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF0B7A4E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="17,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE7FAF1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主题选择卡片（悬停轻微放大） -->
        <Style x:Key="ThemePickCard" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 卡片标题前的绿色小竖条 -->
        <Style x:Key="CardTitleBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3.5"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="RadiusX" Value="1.7"/>
            <Setter Property="Fill" Value="{DynamicResource AccentGlow}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>
        <!-- 设置页一级分类标签：横向紧凑版 ModuleRadio（选中=绿条+高亮底） -->
        <Style x:Key="SettingsTabRadio" TargetType="RadioButton" BasedOn="{StaticResource ModuleRadio}">
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- 网络页表格行：自绘模板，悬停/选中都用主题色（默认 Aero 模板在暗色主题下悬停变白底、
             文字跟着隐身——用户实测"鼠标放上去啥也看不见"） -->
        <Style x:Key="NetRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,1">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 表头：暗色主题用面板底色，避免默认浅灰条 -->
        <Style x:Key="NetHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 上栏一级菜单：选中 = 绿色文字 + 底部指示条 -->
        <Style x:Key="TopNavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="hover" Background="{DynamicResource HoverOverlay}"
                                    CornerRadius="7" Margin="4,8" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="bar" Height="2.5" CornerRadius="1.5" VerticalAlignment="Bottom"
                                    Margin="10,0" Background="{DynamicResource AccentGlow}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentGlow}"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 服务器表（DataGrid）：铺满宽度 + 暗色 -->
        <Style x:Key="NetDataHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SeparatorBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NetDataCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NetDataRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource SideLeftBg}"
                BorderThickness="0" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
                    <Border Width="26" Height="26" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF1ACB82" Offset="0"/>
                                <GradientStop Color="#FF03603E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Width="15" Height="15">
                            <Path Data="M7.5,0.6 V3.3 M7.5,11.7 V14.4" Stroke="White" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Width="10.8" Height="10.8" Stroke="White" StrokeThickness="1.2"/>
                            <Path Data="M6.2,4.7 L10.2,7.5 L6.2,10.3 Z" Fill="White" StrokeLineJoin="Round"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="eFootball 挂机助手" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Pitch Console" FontSize="9.5" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="TopNavHome" GroupName="TopNav" Style="{StaticResource TopNavTab}"
                                 Content="首页" Tag="Home" Checked="TopNav_Checked" IsChecked="True"/>
                    <RadioButton x:Name="TopNavGame" GroupName="TopNav" Style="{StaticResource TopNavTab}"
                                 Content="挂机" Tag="Game" Checked="TopNav_Checked"/>
                    <RadioButton x:Name="TopNavTools" GroupName="TopNav" Style="{StaticResource TopNavTab}"
                                 Content="工具" Tag="Tools" Checked="TopNav_Checked"/>
                    <RadioButton x:Name="TopNavAbout" GroupName="TopNav" Style="{StaticResource TopNavTab}"
                                 Content="关于" Tag="About" Checked="TopNav_Checked"/>
                </StackPanel>

                <ui:TitleBar Grid.Column="3" Title="" ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                             VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*" MinWidth="430"/>
                <ColumnDefinition x:Name="RightCol" Width="*" MinWidth="380" MaxWidth="520"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- ============ 左栏：导航轨道 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SideLeftBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16">
                <!-- 底部：主题切换 -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Rectangle Style="{StaticResource Hairline}" Margin="2,0,2,10"/>
                    <Button x:Name="BtnTheme" Style="{StaticResource NavToolBtn}"
                            Click="BtnTheme_Click" HorizontalAlignment="Stretch"
                            ToolTip="切换界面主题（暗色 / 亮色 / 深蓝）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 3a9 9 0 1 0 0 18c.9 0 1.5-.8 1.3-1.6-.2-1 .6-1.9 1.6-1.9h1.5A3.6 3.6 0 0 0 21 13c0-5.2-4-8.8-9-8.8Z"/>
                            <TextBlock Text="主题外观" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,-8,0" Padding="0,0,8,0" Focusable="False">
                <StackPanel>
                    <!-- 游戏模块 -->
                    <TextBlock x:Name="NavLabelGame" Text="游戏模块" Style="{StaticResource SectionLabel}"/>
                    <RadioButton x:Name="RbCn" Style="{StaticResource ModuleRadio}"
                                 ToolTip="国服（网易实况足球在线，进程 eFootballOnline）"
                                 Checked="RbModule_Checked" Click="RbModule_Click">
                        <StackPanel>
                            <TextBlock Text="国服" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="网易 · 实况足球在线" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource NavDescFg}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbIntl" Style="{StaticResource ModuleRadio}" IsChecked="True"
                                 Checked="RbModule_Checked" Click="RbModule_Click">
                        <StackPanel>
                            <TextBlock Text="国际服" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Steam PC 版" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource NavDescFg}"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 窗口防卡死：游戏窗口被留在屏幕外回不来时一键拉回（还原原位置/主屏居中） -->
                    <Button x:Name="BtnWindowRescue" Style="{StaticResource NavToolBtn}" Click="BtnWindowRescue_Click"
                            Margin="0,6,0,0"
                            ToolTip="游戏窗口不在屏幕上、找不到或被停靠后回不来时，点此把它移回原位置或主屏幕中央（国服/国际服通用）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M4 9V5.5A1.5 1.5 0 0 1 5.5 4H9 M15 4h3.5A1.5 1.5 0 0 1 20 5.5V9 M20 15v3.5a1.5 1.5 0 0 1-1.5 1.5H15 M9 20H5.5A1.5 1.5 0 0 1 4 18.5V15 M9.5 12h5 M12 9.5v5"/>
                            <TextBlock Text="窗口防卡死" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- 工具 -->
                    <TextBlock x:Name="NavLabelTools" Text="工具" Style="{StaticResource SectionLabel}" Margin="4,16,0,8"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource NavToolBtn}" Click="BtnSettings_Click"
                            ToolTip="重要设定（防检测/热键）、画面与性能、手柄与输入、挂机与日志">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M4 7h4.5 M13.5 7H20 M4 12h7.5 M16.5 12H20 M4 17h2.5 M11.5 17H20 M11 5v4 M17 10v4 M9 15v4"/>
                            <TextBlock Text="设置" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDevTools" Style="{StaticResource NavToolBtn}" Click="BtnDevTools_Click"
                            ToolTip="开发者选项：训练数据采集、单步排障等调试功能">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M8 6 3 12l5 6 M16 6l5 6-5 6 M13.5 5 10.5 19"/>
                            <TextBlock Text="开发者" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnUpdate" Style="{StaticResource NavToolBtn}" Click="BtnUpdate_Click"
                            ToolTip="检查更新与更新通道">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 3.5v10 M7.8 9.6L12 13.8l4.2-4.2 M4.5 18.5h15"/>
                            <TextBlock Text="更新" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnGitHub" Style="{StaticResource NavToolBtn}" Click="BtnGitHub_Click"
                            ToolTip="GitHub 加速（GitPort 内核）与 GitHub 域名延迟测速">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M6.5 3.5v9a3.5 3.5 0 0 0 3.5 3.5h6 M6.5 3.5a2 2 0 1 1 .01 0Z M17.5 5.5a2 2 0 1 1 .01 0Z M17.5 16a2 2 0 1 1 .01 0Z M17.5 5.5v9"/>
                            <TextBlock Text="GitHub" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNetwork" Style="{StaticResource NavToolBtn}" Click="BtnNetwork_Click"
                            ToolTip="国际服服务器延迟测试与游戏内连接监控（Npcap + 悬浮窗）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z M3.4 9.4h17.2 M3.4 14.6h17.2 M12 3a15 15 0 0 1 0 18 M12 3a15 15 0 0 0 0 18"/>
                            <TextBlock Text="网络监测" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLogViewer" Style="{StaticResource NavToolBtn}" Click="BtnLogViewer_Click"
                            ToolTip="查看历史运行日志（按日期与级别筛选）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M5.5 4h13v16h-13Z M9 8.5h6 M9 12h6 M9 15.5h4"/>
                            <TextBlock Text="日志历史" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFeedback" Style="{StaticResource NavToolBtn}" Click="BtnFeedback_Click"
                            ToolTip="生成反馈包一键报问题（系统环境、日志与崩溃记录打包）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-2.9-.35-4.1-1L4 20.2l1.2-4.3A8.5 8.5 0 1 1 21 11.5Z M8.8 9.6h6.4 M8.8 13h4.2"/>
                            <TextBlock Text="反馈" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Text="★" Foreground="{DynamicResource Warning}" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- 关于（独立分类：声明） -->
                    <TextBlock x:Name="NavLabelAbout" Text="关于" Style="{StaticResource SectionLabel}" Margin="4,16,0,8"/>
                    <Button x:Name="BtnAbout" Style="{StaticResource NavToolBtn}" Click="BtnAbout_Click"
                            ToolTip="声明与版权信息">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z M12 11.2v5 M12 7.4v.4"/>
                            <TextBlock Text="关于" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- 环境检测 -->
                    <TextBlock Text="环境检测" Style="{StaticResource SectionLabel}" Margin="4,16,0,8"/>
                    <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1" CornerRadius="10" Padding="10,9">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotPad" Width="7" Height="7" Fill="{DynamicResource ModuleDot}"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPad" Text="虚拟手柄驱动" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotWgc" Width="7" Height="7" Fill="{DynamicResource ModuleDot}"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="后台画面捕获" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotOcr" Width="7" Height="7" Fill="{DynamicResource ModuleDot}"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOcr" Text="OCR 语言" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotGame" Width="7" Height="7" Fill="{DynamicResource ModuleDot}"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtGame" Text="游戏窗口（国际服）" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <Rectangle Style="{StaticResource Hairline}" Margin="0,8,0,6"/>
                            <Button x:Name="BtnRecheck" Content="重新检测" Style="{StaticResource LinkBtn}"
                                    HorizontalAlignment="Left" Click="BtnRecheck_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ 中栏：功能卡 + 日志卡 ============ -->
                <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="SubMenuHost" Grid.Row="0" Background="{DynamicResource SideLeftBg}"
                    BorderThickness="0" Padding="20,8,20,8" Visibility="Collapsed">
                <Grid>
                    <StackPanel x:Name="SubMenuIntl" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource SubTab}">
                                <Setter Property="MinHeight" Value="32"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton x:Name="SubRbPreMatch" GroupName="IntlModule" Tag="RbPreMatch"
                                     Checked="SubTab_Checked" Content="★ 赛前快捷设置"/>
