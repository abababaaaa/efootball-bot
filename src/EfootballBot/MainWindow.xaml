                            </TextBlock>

                            <TextBlock Text="反馈交流" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,11">
                                <Run Text="问题反馈与交流请加 QQ 群："/>
                                <Run Text="1128646247" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="。"/>
