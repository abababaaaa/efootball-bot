<Window x:Class="EfootballBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eFootball 挂机助手（手柄后台版）" Height="720" Width="1180"
        Icon="app.ico"
        MinHeight="640" MinWidth="1140"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 横幅白色按钮 -->
        <Style x:Key="BannerBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF0B7A4E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="17,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE7FAF1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主题选择卡片（悬停轻微放大） -->
        <Style x:Key="ThemePickCard" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 卡片标题前的绿色小竖条 -->
        <Style x:Key="CardTitleBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3.5"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="RadiusX" Value="1.7"/>
            <Setter Property="Fill" Value="{DynamicResource AccentGlow}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>
        <!-- 设置页一级分类标签：横向紧凑版 ModuleRadio（选中=绿条+高亮底） -->
        <Style x:Key="SettingsTabRadio" TargetType="RadioButton" BasedOn="{StaticResource ModuleRadio}">
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <!-- 中栏弹性：保底 430 防止页面卡内容被挤没 -->
            <ColumnDefinition Width="*" MinWidth="430"/>
            <!-- 右栏 520 封顶（设计宽度），窄窗口时弹性收缩保底 380，杜绝与中栏重叠 -->
            <ColumnDefinition Width="*" MinWidth="380" MaxWidth="520"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左栏：深色导航轨道 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SideLeftBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="15,16">
                <!-- 底部：主题切换 -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="2,0,2,10"/>
                    <Button x:Name="BtnTheme" Style="{StaticResource NavToolBtn}"
                            Click="BtnTheme_Click" HorizontalAlignment="Stretch"
                            ToolTip="切换界面主题（暗色 / 亮色 / 深蓝）">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 3a9 9 0 1 0 0 18c.9 0 1.5-.8 1.3-1.6-.2-1 .6-1.9 1.6-1.9h1.5A3.6 3.6 0 0 0 21 13c0-5.2-4-8.8-9-8.8Z"/>
                            <TextBlock Text="主题外观" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <!-- 品牌 Logo -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,20">
                        <Border Width="38" Height="38" CornerRadius="11" Effect="{StaticResource AccentShadow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF3FE09D" Offset="0"/>
                                    <GradientStop Color="#FF0C9A61" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="1.4" Opacity="0.95"/>
                                <Path Data="M19,8 V28" Stroke="White" StrokeThickness="1.4" Opacity="0.95"/>
                                <Ellipse Width="2.8" Height="2.8" Fill="White"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="eFootball" FontSize="16.5" FontWeight="Bold"/>
                            <TextBlock Text="挂机助手 · 手柄后台版" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                            <TextBlock Text="by Dabao#1392" FontSize="10"
                                       Foreground="{DynamicResource AccentGlow}" Margin="0,3,0,0"
                                       Opacity="0.9"/>
                            <TextBlock Text="反馈群 1128646247" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 游戏模块 -->
                    <TextBlock Text="游戏模块" Style="{StaticResource SectionLabel}"/>
                    <RadioButton x:Name="RbCn" Style="{StaticResource ModuleRadio}"
                                 ToolTip="国服（网易实况足球在线，进程 eFootballOnline）"
                                 Checked="RbModule_Checked">
                        <StackPanel>
                            <TextBlock Text="国服" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="网易 · 实况足球在线" FontSize="10.5"
                                       Foreground="{DynamicResource NavDescFg}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbIntl" Style="{StaticResource ModuleRadio}" IsChecked="True"
                                 Checked="RbModule_Checked">
                        <StackPanel>
                            <TextBlock Text="国际服" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Steam PC 版" FontSize="10.5"
                                       Foreground="{DynamicResource NavDescFg}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 窗口防卡死：游戏窗口被留在屏幕外回不来时一键拉回（还原原位置/主屏居中） -->
                    <Button x:Name="BtnWindowRescue" Style="{StaticResource NavToolBtn}" Click="BtnWindowRescue_Click"
                            Margin="0,8,0,0"
                            ToolTip="游戏窗口不在屏幕上、找不到或被停靠后回不来时，点此把它移回原位置或主屏幕中央（国服/国际服通用）">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M4 9V5.5A1.5 1.5 0 0 1 5.5 4H9 M15 4h3.5A1.5 1.5 0 0 1 20 5.5V9 M20 15v3.5a1.5 1.5 0 0 1-1.5 1.5H15 M9 20H5.5A1.5 1.5 0 0 1 4 18.5V15 M9.5 12h5 M12 9.5v5"/>
                            <TextBlock Text="窗口防卡死" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- 工具 -->
                    <TextBlock Text="工具" Style="{StaticResource SectionLabel}" Margin="4,14,0,8"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource NavToolBtn}" Click="BtnSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 8.6a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8Z M12 2.8v2.2 M12 19v2.2 M2.8 12h2.2 M19 12h2.2 M5.5 5.5l1.6 1.6 M16.9 16.9l1.6 1.6 M18.5 5.5l-1.6 1.6 M7.1 16.9l-1.6 1.6"/>
                            <TextBlock Text="设置" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnUpdate" Style="{StaticResource NavToolBtn}" Click="BtnUpdate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 3.5v10 M7.8 9.6L12 13.8l4.2-4.2 M4.5 18.5h15"/>
                            <TextBlock Text="更新" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLogViewer" Style="{StaticResource NavToolBtn}" Click="BtnLogViewer_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M5.5 4h13v16h-13Z M9 8.5h6 M9 12h6 M9 15.5h4"/>
                            <TextBlock Text="日志历史" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- 关于（独立分类：诊断报告 / 声明 / 反馈） -->
                    <TextBlock Text="关于" Style="{StaticResource SectionLabel}" Margin="4,16,0,8"/>
                    <Button x:Name="BtnAbout" Style="{StaticResource NavToolBtn}" Click="BtnAbout_Click"
                            ToolTip="诊断报告、声明与反馈群">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z M12 11.2v5 M12 7.4v.4"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="★" Foreground="{DynamicResource Warning}" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="关于与反馈" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 环境检测 -->
                    <TextBlock Text="环境检测" Style="{StaticResource SectionLabel}" Margin="4,16,0,8"/>
                    <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="11,9">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotVigem" Width="8" Height="8" Fill="{DynamicResource ModuleDot}"
                                         Margin="1,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtVigem" Text="ViGEmBus 驱动" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotWgc" Width="8" Height="8" Fill="{DynamicResource ModuleDot}"
                                         Margin="1,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="后台画面捕获" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotOcr" Width="8" Height="8" Fill="{DynamicResource ModuleDot}"
                                         Margin="1,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOcr" Text="OCR 语言" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse x:Name="DotGame" Width="8" Height="8" Fill="{DynamicResource ModuleDot}"
                                         Margin="1,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtGame" Text="游戏窗口（国际服）" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <Button x:Name="BtnRecheck" Content="重新检测" Style="{StaticResource GhostBtn}"
                                    HorizontalAlignment="Left" Margin="1,9,0,0" Padding="11,4" FontSize="11"
                                    Click="BtnRecheck_Click"/>
                            <Button x:Name="BtnInstallVigem" Content="安装内置驱动" Style="{StaticResource GhostBtn}"
                                    HorizontalAlignment="Left" Margin="1,5,0,0" Padding="11,4" FontSize="11"
                                    Click="BtnInstallVigem_Click"
                                    ToolTip="使用内置安装包离线安装 ViGEmBus 驱动（需管理员授权，无需联网）"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 中栏：功能卡 + 日志卡 ============ -->
        <Grid Grid.Column="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 更新提醒横幅（有新版本时显示） -->
            <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
                    CornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                    BorderBrush="#5535D392" BorderThickness="1"
                    Effect="{StaticResource FloatShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF12B072" Offset="0"/>
                        <GradientStop Color="#FF0B8A58" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#33FFFFFF"
                                VerticalAlignment="Center" Margin="0,0,11,0">
                            <TextBlock Text="🎉" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="TxtUpdateBannerTitle" Text="发现新版本" FontWeight="Bold" Foreground="White" FontSize="13"/>
                            <TextBlock x:Name="TxtUpdateBannerDesc" Text="" Foreground="#E6F8EF" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnBannerUpdate" Content="立即更新"
                            Style="{StaticResource BannerBtn}" VerticalAlignment="Center"
                            Click="BtnBannerUpdate_Click"/>
                </Grid>
            </Border>

            <!-- ===== 国际服面板 ===== -->
            <Border x:Name="PanelIntl" Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <!-- 模块入口（居中，内容按选中切换）：★赛前快捷设置 / 我的联赛 / 周活动 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                        <RadioButton x:Name="RbPreMatch" GroupName="IntlModule"
                                     Style="{StaticResource ModuleRadio}"
                                     Checked="RbPreMatch_Checked"
                                     ToolTip="开赛前一键打开游戏自带的设置工具，调整画质、分辨率、键位">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="★" Foreground="{DynamicResource Warning}" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="赛前快捷设置" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbMyLeague" GroupName="IntlModule" Content="我的联赛"
                                     Style="{StaticResource ModuleRadio}" Margin="22,0,0,0" IsChecked="True"
                                     Checked="RbMyLeague_Checked"/>
                        <RadioButton x:Name="RbWeekly" GroupName="IntlModule" Content="周活动"
                                     Style="{StaticResource ModuleRadio}" Margin="22,0,0,0"
                                     Checked="RbWeekly_Checked"/>
                        <RadioButton x:Name="RbAiLadder" GroupName="IntlModule" Content="AI天梯联赛"
                                     Style="{StaticResource ModuleRadio}" Margin="22,0,0,0"
                                     ToolTip="国际服 eFootball™联赛·对阵AI类别：组别循环冲级，可设达到组别停止"
                                     Checked="RbAiLadder_Checked"/>
                    </StackPanel>

                    <!-- 赛前快捷设置内容（按入口选中切换显示）：一键打开游戏自带设置工具 -->
                    <StackPanel x:Name="PreMatchContent" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★" Foreground="{DynamicResource Warning}" FontSize="15.5"
                                               VerticalAlignment="Center" Margin="0,0,8,1"/>
                                    <TextBlock Text="赛前快捷设置" FontSize="16.5" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" MaxWidth="520" Margin="0,9,0,0">
                                    <Run Text="一键"/>
                                    <Run Text="启动游戏本体或打开自带设置工具" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                    <Run Text="，调整"/>
                                    <Run Text="画质、分辨率、键位" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                    <Run Text="。工具位置"/>
                                    <Run Text="自动定位" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                    <Run Text="；找不到时"/>
                                    <Run Text="先启动一次游戏再点" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                    <Run Text="即可。"/>
                                </TextBlock>
                                <TextBlock x:Name="TxtPreMatchPath" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" MaxWidth="520" Margin="0,8,0,0"
                                           Text="尚未定位（点击右侧按钮后显示结果）"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Top">
                                <Button x:Name="BtnLaunchGame" Content="快速打开游戏"
                                        Style="{StaticResource PrimaryBtn}" Width="210" Height="40" FontSize="14"
                                        Click="BtnLaunchGame_Click"
                                        ToolTip="启动国际服游戏本体：优先经 Steam 拉起（Steam 未启动会自动带起），游戏已在运行时不重复启动"/>
                                <Button x:Name="BtnOpenGameSettings" Content="打开设置工具"
                                        Style="{StaticResource PrimaryBtn}" Width="210" Height="40" FontSize="14" Margin="0,8,0,0"
                                        Click="BtnOpenGameSettings_Click"
                                        ToolTip="启动游戏安装目录下的 Settings.exe（与游戏本体同目录）"/>
                                <Button x:Name="BtnOpenGameDir" Content="打开游戏目录"
                                        Style="{StaticResource GhostBtn}" Width="210" Height="34" FontSize="13" Margin="0,8,0,0"
                                        Click="BtnOpenGameDir_Click"
                                        ToolTip="在资源管理器中打开游戏本体安装目录"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 我的联赛内容 -->
                    <StackPanel x:Name="LeagueContent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentGlow}"
                                         VerticalAlignment="Center" Margin="0,0,9,1"/>
                                <TextBlock Text="我的联赛挂机" FontSize="16.5" FontWeight="Bold"/>
                            </StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" MaxWidth="520" Margin="0,9,0,0">
                                    <Run Text="自动打完"/>
                                    <Run Text="「我的联赛」" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                    <Run Text="全部比赛："/>
                                    <Run Text="自动核对比赛难度" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                    <Run Text="，物品页"/>
                                    <Run Text="自动购买加成道具" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                    <Run Text="，达到设定场次"/>
                                    <Run Text="自动停止并还原窗口" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                    <Run Text="；卡住会自动恢复，无需照看。"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" MaxWidth="520" Margin="0,7,0,0">
                                    <Run Text="需连接"/>
                                    <Run Text="虚拟手柄" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                    <Run Text="，开始前请"/>
                                    <Run Text="断开真实手柄" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                    <Run Text="。"/>
                                </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Top">
                            <Button x:Name="BtnStartMyLeague" Content="开始"
                                    Style="{StaticResource PrimaryBtn}" Width="210" Height="40" FontSize="14"
                                    Click="BtnStartMyLeague_Click"/>
                            <!-- 暂停/继续与停止放在一起（加宽：长热键文字不被截断） -->
                            <Button x:Name="BtnPause" Content="未开始" Style="{StaticResource DangerBtn}"
                                    Width="210" Height="34" FontSize="13" Margin="0,8,0,0"
                                    IsEnabled="False" Click="BtnPause_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 比赛难度（必选，独立置顶，与游戏内选择赛事等级一一对应） -->
                    <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                        <TextBlock Text="比赛难度" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbDifficulty" Width="150" Margin="12,0,0,0" SelectedIndex="0" VerticalAlignment="Center">
                            <ComboBoxItem Content="新手"/>
                            <ComboBoxItem Content="业余"/>
                            <ComboBoxItem Content="标准"/>
                            <ComboBoxItem Content="职业"/>
                            <ComboBoxItem Content="顶尖球员"/>
                            <ComboBoxItem Content="超级球星"/>
                            <ComboBoxItem Content="传奇"/>
                        </ComboBox>
                    </StackPanel>
