                                <TextBlock Text="画面捕获方式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbCaptureMode" Width="240" Margin="10,0,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="WGC 窗口捕获（后台挂机，推荐）"/>
                                    <ComboBoxItem Content="DXGI 桌面复制（更快，但窗口须可见）"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,9">
                                <Run Text="WGC 为 Windows 官方"/>
                                <Run Text="后台捕获" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="（Discord/OBS 同款）：游戏被遮挡、你操作其他软件时照常挂机；DXGI 高分辨率略快，但"/>
                                <Run Text="窗口必须可见" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                <Run Text="。建议游戏使用"/>
                                <Run Text="无边框窗口模式" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="。更改在下次开始挂机时生效。"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
