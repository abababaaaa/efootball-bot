<Window x:Class="EfootballBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eFootball 挂机助手（手柄后台版）" Height="720" Width="1180"
        Icon="app.ico"
        MinHeight="640" MinWidth="1020"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="372"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左栏：贴边深色导航，分组无框 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SideLeftBg}">
            <DockPanel Margin="18,18">
                <!-- 主题按钮贴底 -->
                <Button x:Name="BtnTheme" DockPanel.Dock="Bottom" Content="主题外观"
                        Style="{StaticResource GhostBtn}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Click="BtnTheme_Click"
                        ToolTip="切换界面主题（暗色 / 亮色 / 深蓝）"/>

                <StackPanel>
                    <!-- 品牌 -->
                    <StackPanel Margin="1,0,0,22">
                        <TextBlock Text="eFootball" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="挂机助手 · 手柄后台版" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- 游戏模块 -->
                    <TextBlock Text="游戏模块" Style="{StaticResource SectionLabel}"/>
                    <RadioButton x:Name="RbCn" Style="{StaticResource ModuleRadio}"
                                 ToolTip="国服（网易实况足球在线，进程 eFootballOnline）"
                                 Checked="RbModule_Checked">
                        <StackPanel>
                            <TextBlock Text="国服" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="网易 · 实况足球在线" FontSize="10.5"
                                       Foreground="{DynamicResource NavDescFg}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbIntl" Style="{StaticResource ModuleRadio}" IsChecked="True"
                                 Checked="RbModule_Checked">
                        <StackPanel>
                            <TextBlock Text="国际服" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Steam PC 版" FontSize="10.5"
                                       Foreground="{DynamicResource NavDescFg}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 工具（设置 / 日志） -->
                    <TextBlock Text="工具" Style="{StaticResource SectionLabel}" Margin="0,14,0,0"/>
                    <Button x:Name="BtnSettings" Content="设置"
                            Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Left" Margin="2,4,0,0"
                            Padding="14,5" FontSize="12.5" Click="BtnSettings_Click"/>
                    <Button x:Name="BtnUpdate" Content="更新"
                            Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Left" Margin="2,4,0,0"
                            Padding="14,5" FontSize="12.5" Click="BtnUpdate_Click"/>
                    <Button x:Name="BtnLogViewer" Content="日志历史"
                            Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Left" Margin="2,4,0,0"
                            Padding="14,5" FontSize="12.5" Click="BtnLogViewer_Click"/>

                    <!-- 环境检测 -->
                    <TextBlock Text="环境检测" Style="{StaticResource SectionLabel}" Margin="3,20,0,8"/>
                    <StackPanel Margin="2,0">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="DotVigem" Width="9" Height="9" Fill="{DynamicResource ModuleDot}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ViGEmBus 驱动" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="DotWgc" Width="9" Height="9" Fill="{DynamicResource ModuleDot}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="后台画面捕获" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="DotOcr" Width="9" Height="9" Fill="{DynamicResource ModuleDot}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtOcr" Text="OCR 语言" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="DotGame" Width="9" Height="9" Fill="{DynamicResource ModuleDot}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGame" Text="游戏窗口（国际服）" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <Button x:Name="BtnRecheck" Content="重新检测" Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Left" Margin="2,10,0,0" Click="BtnRecheck_Click"/>
                        <Button x:Name="BtnInstallVigem" Content="安装 ViGEmBus 驱动" Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Left" Margin="2,4,0,0" Click="BtnInstallVigem_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 中栏：功能卡 + 日志卡 ============ -->
        <Grid Grid.Column="1" Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 更新提醒横幅（有新版本时显示） -->
            <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
                    Background="#2d7a4f" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock x:Name="TxtUpdateBannerTitle" Text="发现新版本" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                            <TextBlock x:Name="TxtUpdateBannerDesc" Text="" Foreground="#e0e0e0" FontSize="11.5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnBannerUpdate" Content="立即更新" Padding="16,5"
                            Background="White" Foreground="#2d7a4f" FontWeight="SemiBold" BorderThickness="0"
                            Click="BtnBannerUpdate_Click"/>
                </Grid>
            </Border>

            <!-- 国际服功能分段（国服时隐藏） -->
            <StackPanel x:Name="IntlTabsBar" Grid.Row="1" Orientation="Horizontal" Margin="1,0,0,12">
                <RadioButton x:Name="TabLeague" Content="我的联赛" Style="{StaticResource SegTab}"
                             IsChecked="True" Checked="IntlTab_Checked"/>
                <RadioButton x:Name="TabWeekly" Content="周活动" Style="{StaticResource SegTab}"
                             Checked="IntlTab_Checked"/>
            </StackPanel>

            <!-- 国服功能分段（国服时可见） -->
            <StackPanel x:Name="CnTabsBar" Grid.Row="1" Orientation="Horizontal" Margin="1,0,0,12" Visibility="Collapsed">
                <RadioButton x:Name="TabCnTour" Content="巡回赛" Style="{StaticResource SegTab}"
                             IsChecked="True"/>
            </StackPanel>

            <!-- ===== 国际服功能卡（三 Pane 叠放） ===== -->
            <Border x:Name="PanelIntl" Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <!-- 我的联赛 -->
                    <Grid x:Name="PaneLeague">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentGlow}"
                                         VerticalAlignment="Center" Margin="0,0,9,1"/>
                                <TextBlock Text="我的联赛" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="自动进出我的联赛，AI 代打，可只踢关键比赛（4 倍经验）"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="ChkOnlyKey" Content="只踢关键比赛（普通比赛弃权）" IsChecked="False"/>
                                <CheckBox x:Name="ChkBuy4x" Content="自动购买 4 倍经验道具" IsChecked="False"/>
                                <CheckBox x:Name="ChkBuyCond" Content="自动购买杰出状态道具" IsChecked="False"/>
                                <CheckBox x:Name="ChkBuyMgr" Content="自动购买教练强化道具" IsChecked="False"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="目标场次（0=不限）" VerticalAlignment="Center"
                                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBox x:Name="TxtTarget" Width="64" Margin="9,0,0,0" Text="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="比赛难度" VerticalAlignment="Center"
                                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                    <ComboBox x:Name="CmbDifficulty" Width="112" Margin="9,0,0,0" SelectedIndex="4">
                                        <ComboBoxItem Content="新手"/>
                                        <ComboBoxItem Content="业余"/>
                                        <ComboBoxItem Content="职业"/>
                                        <ComboBoxItem Content="超级球星"/>
                                        <ComboBoxItem Content="传奇"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TxtLeagueHotkey" Text="停止热键：Ctrl+Shift+Q"
                                       Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,16,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnMyLeague" Grid.Column="1" Content="开始"
                                Style="{StaticResource PrimaryBtn}" Width="90"
                                VerticalAlignment="Top" Margin="14,2,0,0" Click="BtnMyLeague_Click"/>
                    </Grid>

                    <!-- 周活动 -->
                    <Grid x:Name="PaneWeekly" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#FFA05AE0"
                                         VerticalAlignment="Center" Margin="0,0,9,1"/>
                                <TextBlock Text="周活动" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="自动进入对阵AI，从最左逐个清挑战/巡回活动；巡回赛自动设置赛事等级、自动控制开、弹性关"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="赛事等级" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox x:Name="CmbWeeklyDiff" Width="112" Margin="9,0,0,0" SelectedIndex="5">
                                    <ComboBoxItem Content="新手"/>
                                    <ComboBoxItem Content="业余"/>
                                    <ComboBoxItem Content="职业"/>
                                    <ComboBoxItem Content="顶尖球员"/>
                                    <ComboBoxItem Content="超级球星"/>
                                    <ComboBoxItem Content="传奇"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="TxtWeeklyHotkey" Text="停止热键：Ctrl+Shift+Q"
                                       Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,16,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnWeekly" Grid.Column="1" Content="开始"
                                Style="{StaticResource PrimaryBtn}" Width="90"
                                VerticalAlignment="Top" Margin="14,2,0,0" Click="BtnWeekly_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 国服面板 ===== -->
            <Border x:Name="PanelCn" Grid.Row="2" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                <StackPanel>
                    <!-- 巡回赛功能 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#FFE0A14C"
                                         VerticalAlignment="Center" Margin="0,0,9,1"/>
                                <TextBlock Text="国服巡回赛" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="自动进入比赛活动 → 对阵电脑巡回赛，难度继承上次，循环刷赛"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="场次上限（0=不限）" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="TxtCnDailyLoop" Width="64" Margin="9,0,0,0" Text="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCnHotkey" Text="停止热键：Ctrl+Shift+Q"
                                       Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,16,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnCnDaily" Grid.Column="1" Content="开始"
                                Style="{StaticResource PrimaryBtn}" Width="90"
                                VerticalAlignment="Top" Margin="14,2,0,0" Click="BtnCnDaily_Click"/>
                    </Grid>

                    <!-- 使用提示（收纳到卡底部） -->
                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,16,0,12"/>
                    <TextBlock Text="国服使用提示" Style="{StaticResource H2}" Margin="0,0,0,9"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" LineHeight="19">
                        1. 先启动国服「实况足球在线」并进入游戏主界面，再点开始。&#x0a;
                        2. 开始前请断开真实手柄（拔出接收器/蓝牙断开），否则虚拟手柄只能当玩家2，菜单不响应。&#x0a;
                        3. 手柄输入 + 后台捕获：游戏窗口无需置顶。&#x0a;
                        4. 首次使用请确认左侧 ViGEmBus 驱动灯为绿色。&#x0a;
                        5. 游戏语言需为简体中文。&#x0a;
                        6. 国服流程为初版，卡住时请把日志与预览截图反馈以便校准。
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ===== 设置面板 ===== -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="全局停止热键" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="游戏全屏时也能快速停止机器人" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ChkHotkeyEnabled" Content="启用全局停止热键" IsChecked="True"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="修饰键" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Width="60"/>
                                <CheckBox x:Name="ChkHotkeyCtrl" Content="Ctrl" IsChecked="True" Margin="4,0,8,0"/>
                                <CheckBox x:Name="ChkHotkeyShift" Content="Shift" IsChecked="True" Margin="4,0,8,0"/>
                                <CheckBox x:Name="ChkHotkeyAlt" Content="Alt" Margin="4,0,8,0"/>
                                <CheckBox x:Name="ChkHotkeyWin" Content="Win" Margin="4,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="主键" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Width="60"/>
                                <TextBox x:Name="TxtHotkey" Width="140" IsReadOnly="True"
                                         Text="Q" Padding="8,4" FontSize="13"
                                         KeyDown="TxtHotkey_KeyDown" PreviewKeyDown="TxtHotkey_PreviewKeyDown"/>
                                <TextBlock Text="（点击后按键捕获）" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtHotkeyPreview" Text="当前热键：Ctrl+Shift+Q"
                                       Foreground="{DynamicResource AccentGlow}" FontSize="12.5"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="结束行为" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkAutoClose" Content="全部流程完毕后自动关闭程序" IsChecked="False"/>
                            <CheckBox x:Name="ChkMinimizeTray" Content="结束后最小化到托盘（暂未实现）" IsChecked="False" IsEnabled="False" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="性能 / 内存" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkPeriodicGc" Content="挂机期间定期强制 GC（每 5 分钟）" IsChecked="True"/>
                            <CheckBox x:Name="ChkAutoWindowize" IsChecked="False" Margin="0,6,0,0"
                                      Content="挂机时自动窗口化游戏到 1280×720（该游戏独占全屏模式下无效，建议切无边框窗口后启用）"/>
                            <TextBlock Margin="0,8,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Text="提示：若自动窗口化被游戏抵抗（日志显示「保持全屏运行」），说明游戏是独占全屏。请在游戏启动器/Steam 中把显示模式改为「无边框窗口」，挂机负载即可大幅降低。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="OCR 识别频率" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox x:Name="CmbOcrInterval" Width="112" Margin="9,0,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="500 ms"/>
                                    <ComboBoxItem Content="900 ms"/>
                                    <ComboBoxItem Content="1500 ms"/>
                                    <ComboBoxItem Content="2500 ms"/>
                                    <ComboBoxItem Content="5000 ms"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="预览刷新间隔" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox x:Name="CmbPreviewInterval" Width="112" Margin="9,0,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="150 ms"/>
                                    <ComboBoxItem Content="300 ms"/>
                                    <ComboBoxItem Content="500 ms"/>
                                    <ComboBoxItem Content="1000 ms"/>
                                    <ComboBoxItem Content="2000 ms"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="日志" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkFileLog" Content="启用文件日志（写入 logs\ 目录）" IsChecked="True"/>
                            <CheckBox x:Name="ChkShowRuntimeLog" Content="显示底部运行日志卡" IsChecked="True" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="日志文件保留数量" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="TxtMaxLogFiles" Width="64" Margin="9,0,0,0" Text="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="文件日志级别" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox x:Name="CmbFileLogLevel" Width="112" Margin="9,0,0,0" SelectedIndex="3">
                                    <ComboBoxItem Content="Info"/>
                                    <ComboBoxItem Content="Warn"/>
                                    <ComboBoxItem Content="Error"/>
                                    <ComboBoxItem Content="Debug"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnOpenLogFolder" Content="打开日志文件夹" Style="{StaticResource GhostBtn}" Padding="14,5" Click="BtnOpenLogFolder_Click"/>
                                <TextBlock Text="所有改动自动保存" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 自动更新面板（独立） ===== -->
            <ScrollViewer x:Name="UpdatePanel" Grid.Row="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="自动更新" Style="{StaticResource H2}" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="当前版本" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" Width="80" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCurrentVersion" Text="v0.9.0" Foreground="{DynamicResource AccentGlow}" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="GitHub 仓库" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" Width="80" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUpdateRepo" Text="abababaaaa/efootball-bot"
                                           Foreground="{DynamicResource AccentGlow}" FontSize="12.5" VerticalAlignment="Center"
                                           Cursor="Hand" ToolTip="打开仓库主页"
                                           MouseLeftButtonUp="TxtUpdateRepo_MouseLeftButtonUp"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkCheckOnStartup" Content="启动时自动检查更新" IsChecked="True" Margin="0,4,0,0"/>
                            <CheckBox x:Name="ChkIncludePrerelease" Content="包含测试版（pre-release）" IsChecked="False"/>
                            <CheckBox x:Name="ChkAutoDownloadInstall" Content="发现更新后自动下载安装" IsChecked="False"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BtnCheckUpdate" Content="检查更新" Padding="14,5" Click="BtnCheckUpdate_Click"/>
                                <Button x:Name="BtnApplyUpdate" Content="立即更新" Padding="14,5" Margin="10,0,0,0"
                                        IsEnabled="False" Click="BtnApplyUpdate_Click"/>
                            </StackPanel>

                            <ProgressBar x:Name="PbUpdate" Height="6" Margin="0,10,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtUpdateStatus" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,6,0,0"/>

                            <Border Margin="0,14,0,0" Background="{DynamicResource Surface2}" CornerRadius="6" Padding="10" Visibility="Collapsed" x:Name="ChangelogBox">
                                <StackPanel>
                                    <TextBlock Text="更新日志" Foreground="{DynamicResource AccentGlow}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtChangelog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" MaxHeight="200"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                             Cursor="Arrow"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 历史日志查看器 ===== -->
            <Border x:Name="LogViewerPanel" Grid.Row="2" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="日志历史" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbLogFiles" Width="280" Margin="14,0,0,0" SelectionChanged="CmbLogFiles_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnRefreshLogs" Content="刷新" Style="{StaticResource GhostBtn}" Padding="10,3" FontSize="11" Click="BtnRefreshLogs_Click"/>
                            <Button x:Name="BtnOpenLogFolder2" Content="打开文件夹" Style="{StaticResource GhostBtn}" Padding="10,3" FontSize="11" Margin="8,0,0,0" Click="BtnOpenLogFolder_Click"/>
                            <Button x:Name="BtnDeleteLog" Content="删除选中" Style="{StaticResource GhostBtn}" Padding="10,3" FontSize="11" Margin="8,0,0,0" Click="BtnDeleteLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 日志内容 -->
                    <ListBox x:Name="LogFileContent" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Margin="0,8,0,0" FontFamily="Consolas" FontSize="11.5"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,0.5"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 状态栏 -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <TextBlock x:Name="LogFileStatus" Text="—" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 日志卡（两套面板共用） ===== -->
            <Border x:Name="LogCard" Style="{StaticResource Card}" Grid.Row="3" Margin="0,12,0,0" Height="248">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="运行日志" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Button Content="清空" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right"
                                Padding="10,3" FontSize="11" Click="BtnClearLog_Click"/>
                    </Grid>
                    <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Margin="0,6,0,0"
                             FontFamily="Consolas" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 右栏：贴边辅助栏，分组无框 ============ -->
        <Border Grid.Column="2" Background="{DynamicResource SideRightBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,18">
                    <!-- 实时画面 -->
                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="实时画面" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnPreview" Content="开启预览" Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Right" Padding="10,3" FontSize="11"
                                Click="BtnPreview_Click"/>
                    </Grid>
                    <Border Background="{DynamicResource PreviewBg}" CornerRadius="8" Height="190"
                            ClipToBounds="True">
                        <Image x:Name="Preview" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="TxtScreen" Text="当前画面：—" Foreground="{DynamicResource TextSecondary}"
                               FontSize="12" Margin="0,8,0,0"/>

                    <!-- 统计：仪表盘式指标格 -->
                    <TextBlock Text="统计" Style="{StaticResource H2}" Margin="0,24,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock x:Name="StMatches" Text="0" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="完成场次" Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,18">
                            <TextBlock x:Name="StKey" Text="0" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="关键比赛" Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock x:Name="StForfeit" Text="0" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="弃权场次" Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock x:Name="StElapsed" Text="—" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="运行时长" Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StError" Foreground="{DynamicResource Danger}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,0"/>

                    <!-- 使用提示 -->
                    <TextBlock Text="使用提示" Style="{StaticResource H2}" Margin="0,24,0,9"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" LineHeight="19">
                        1. 手柄输入 + 后台捕获：游戏窗口无需置顶，可最小化干活去。&#x0a;
                        2. 首次使用先点「安装 ViGEmBus 驱动」，装完重启本程序。&#x0a;
                        3. 游戏内建议：小窗口、100 FPS、选手操作设为 AI、难度与上方选择一致。&#x0a;
                        4. 游戏语言需为简体中文（OCR 以中文识别为主）。
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== 主题选择覆盖层（首次启动 / 手动触发） ===== -->
        <Border x:Name="ThemeOverlay" Grid.ColumnSpan="3" Background="{DynamicResource WindowBg}"
                Visibility="Collapsed" Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="选择您的主题" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="您可以通过左侧栏底部的「主题外观」随时更改" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- 主题卡片 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- 暗色 -->
                    <Border x:Name="CardDark" CornerRadius="10" Padding="3" Margin="8" Cursor="Hand"
                            Background="{DynamicResource AccentLight}" BorderBrush="{DynamicResource Accent}"
                            BorderThickness="2" MouseLeftButtonUp="ThemeCard_Click" Tag="Dark">
                        <StackPanel>
                            <Border CornerRadius="8" Width="160" Height="100" Background="#FF0E1218"
                                    BorderBrush="#FF303B4D" BorderThickness="1" Padding="8">
                                <Grid>
                                    <Rectangle Width="30" Height="70" Fill="#FF0A0E14" RadiusX="3" RadiusY="3"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <StackPanel Margin="38,2,0,0">
                                        <Rectangle Height="6" Width="80" Fill="#FFEDF1F7" RadiusX="3" RadiusY="3" Margin="0,0,0,6"/>
                                        <Rectangle Height="4" Width="60" Fill="#FF7E899B" RadiusX="2" RadiusY="2" Margin="0,0,0,4"/>
                                        <Rectangle Height="4" Width="70" Fill="#FF7E899B" RadiusX="2" RadiusY="2" Margin="0,0,0,4"/>
                                        <Rectangle Height="4" Width="55" Fill="#FF7E899B" RadiusX="2" RadiusY="2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="暗色" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 亮色 -->
                    <Border x:Name="CardLight" CornerRadius="10" Padding="3" Margin="8" Cursor="Hand"
                            Background="Transparent" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="2" MouseLeftButtonUp="ThemeCard_Click" Tag="Light">
                        <StackPanel>
                            <Border CornerRadius="8" Width="160" Height="100" Background="#FFF5F7FA"
                                    BorderBrush="#FFD0D5DD" BorderThickness="1" Padding="8">
                                <Grid>
                                    <Rectangle Width="30" Height="70" Fill="#FFE9EDF2" RadiusX="3" RadiusY="3"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <StackPanel Margin="38,2,0,0">
                                        <Rectangle Height="6" Width="80" Fill="#FF1A1A2E" RadiusX="3" RadiusY="3" Margin="0,0,0,6"/>
                                        <Rectangle Height="4" Width="60" Fill="#FF5A5A72" RadiusX="2" RadiusY="2" Margin="0,0,0,4"/>
                                        <Rectangle Height="4" Width="70" Fill="#FF5A5A72" RadiusX="2" RadiusY="2" Margin="0,0,0,4"/>
                                        <Rectangle Height="4" Width="55" Fill="#FF5A5A72" RadiusX="2" RadiusY="2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="亮色" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 深蓝 -->
                    <Border x:Name="CardDeepBlue" CornerRadius="10" Padding="3" Margin="8" Cursor="Hand"
                            Background="Transparent" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="2" MouseLeftButtonUp="ThemeCard_Click" Tag="DeepBlue">
                        <StackPanel>
                            <Border CornerRadius="8" Width="160" Height="100" Background="#FF0A1628"
                                    BorderBrush="#FF1E3A5F" BorderThickness="1" Padding="8">
                                <Grid>
                                    <Rectangle Width="30" Height="70" Fill="#FF081220" RadiusX="3" RadiusY="3"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <StackPanel Margin="38,2,0,0">
                                        <Rectangle Height="6" Width="80" Fill="#FFE0E6ED" RadiusX="3" RadiusY="3" Margin="0,0,0,6"/>
                                        <Rectangle Height="4" Width="60" Fill="#FF5A7A9E" RadiusX="2" RadiusY="2" Margin="0,0,0,4"/>
                                        <Rectangle Height="4" Width="70" Fill="#FF5A7A9E" RadiusX="2" RadiusY="2" Margin="0,0,0,4"/>
                                        <Rectangle Height="4" Width="55" Fill="#FF5A7A9E" RadiusX="2" RadiusY="2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="深蓝" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 确认按钮 -->
                <Button x:Name="BtnThemeConfirm" Content="继续" Style="{StaticResource PrimaryBtn}"
                        Width="200" Margin="0,28,0,0" HorizontalAlignment="Center"
                        Click="BtnThemeConfirm_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
