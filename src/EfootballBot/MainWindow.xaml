                            <Button x:Name="BtnStartCnMyLeague" Grid.Column="1" Content="开始"
                                    Style="{StaticResource PrimaryBtn}" Width="210" Height="40" FontSize="14"
                                    VerticalAlignment="Top" Margin="16,4,0,0" Click="BtnStartCnMyLeague_Click"/>
                        </Grid>

                        <!-- 比赛难度（与游戏内选择赛事等级一一对应；国服独立配置） -->
                        <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                            <TextBlock Text="比赛难度" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbCnMlDifficulty" Width="150" Margin="12,0,0,0" SelectedIndex="0" VerticalAlignment="Center">
