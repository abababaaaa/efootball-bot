                                    <ComboBoxItem Content="RapidOCR PP-OCRv6（精准，推荐）"/>
                                    <ComboBoxItem Content="Windows 内置 OCR（更快，回退用）"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,9">
                                <Run Text="PP-OCRv6 为随程序自带的"/>
                                <Run Text="离线模型" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="（约 30MB，不联网、不装第三方软件），对游戏美术字、小号说明文字的识别显著更好，代价是稍慢；引擎异常时可"/>
                                <Run Text="随时切回 Windows OCR" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="。更改在下次开始挂机时生效。"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
