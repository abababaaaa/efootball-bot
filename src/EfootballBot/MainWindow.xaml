                                    <TextBlock Text="全局热键" Style="{StaticResource H2}"/>
                                    <TextBlock Text="暂停/停止与恢复，游戏全屏时也能响应" Foreground="{DynamicResource TextMuted}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <CheckBox x:Name="ChkHotkeyEnabled" Content="启用全局热键" IsChecked="True"
                                      Checked="ChkHotkeyEnabled_Changed" Unchecked="ChkHotkeyEnabled_Changed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="暂停/停止" Style="{StaticResource FieldLabel}" Width="72"/>
                                <Button x:Name="BtnRecordHotkeyMain" Content="点击记录按键" Width="180"
                                        Style="{StaticResource GhostBtn}" Click="BtnRecordHotkeyMain_Click"/>
                                <TextBlock x:Name="LblHotkeyMain" Text="Ctrl+Shift+Q"
                                           Foreground="{DynamicResource AccentGlow}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"
                                       MaxWidth="520" Margin="0,4,0,0">
                                <Run Text="运行中第一次按="/>
                                <Run Text="暂停" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="，暂停中再按="/>
                                <Run Text="彻底停止" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text="。支持键盘任意键与鼠标键（可含修饰键），游戏全屏时也能响应。"/>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="恢复" Style="{StaticResource FieldLabel}" Width="72"/>
                                <Button x:Name="BtnRecordHotkeyResume" Content="点击记录按键" Width="180"
                                        Style="{StaticResource GhostBtn}" Click="BtnRecordHotkeyResume_Click"/>
                                <TextBlock x:Name="LblHotkeyResume" Text="Ctrl+Shift+R"
                                           Foreground="{DynamicResource AccentGlow}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
