                                    <CheckBox x:Name="ChkBuyConditionBoost" Content="购买状态加成" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbConditionLevel" Width="78" Margin="12,0,0,0" SelectedIndex="0">
