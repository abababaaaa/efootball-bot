                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="520" Margin="2,4,0,0"
                                   Text="0（无限）= 打满冠军赛全程或手动停止。冠军赛每期固定 7 场（小组赛 1~3、1/8 决赛、1/4 决赛、半决赛、决赛），想打满整期选 7。达到设定场次（本次挂机累计）即自动停止并还原窗口。国服活动设置（赛事等级等）待实机校准后补充。"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 设置面板 ===== -->
