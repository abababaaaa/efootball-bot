                                      Checked="ChkHidHideEnabled_Changed" Unchecked="ChkHidHideEnabled_Changed"/>
                            <TextBlock x:Name="TxtHidHideStatus" FontSize="11.5" Margin="28,4,0,0"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                       Text="正在检查状态…"/>

                            <CheckBox x:Name="ChkHidePhysical" FontWeight="SemiBold" Margin="0,10,0,0"
                                      Checked="ChkHidePhysical_Changed" Unchecked="ChkHidePhysical_Changed">
                                <StackPanel>
                                    <TextBlock Text="挂机时自动禁用真实手柄（释放玩家 1）" FontSize="12.5"/>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" MaxWidth="520" Margin="0,3,0,0">
                                        <Run Text="真实手柄会占用玩家 1，虚拟手柄输入将被游戏忽略。开启后"/>
                                        <Run Text="启动挂机自动禁用真实手柄、退出自动恢复" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                        <Run Text="；首次需管理员授权注册系统任务，之后"/>
                                        <Run Text="全自动" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                        <Run Text="。"/>
                                    </TextBlock>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- ============ 二级页：挂机与日志 ============ -->
                    <StackPanel x:Name="SetTabDaily" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="结束行为" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoClose" Content="全部流程完毕后自动关闭程序" IsChecked="False"/>
                            <CheckBox x:Name="ChkMinimizeTray" Content="结束后最小化到托盘（暂未实现）" IsChecked="False" IsEnabled="False" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- （挂机节奏已移至「★重要设定」页） -->

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="日志" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkFileLog" Content="启用文件日志（写入 logs\ 目录）" IsChecked="True"/>
                            <CheckBox x:Name="ChkShowRuntimeLog" Content="显示底部运行日志卡" IsChecked="True" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="保留数量" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtMaxLogFiles" Width="56" Margin="8,0,0,0" Text="10"/>
                                <TextBlock Text="个 / 超" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
                                <TextBox x:Name="TxtLogRetentionDays" Width="56" Margin="8,0,0,0" Text="7"/>
                                <TextBlock Text="天自动清理（.yml 记事本可开）" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="文件日志级别" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbFileLogLevel" Width="116" Margin="10,0,0,0" SelectedIndex="3">
                                    <ComboBoxItem Content="Info"/>
                                    <ComboBoxItem Content="Warn"/>
                                    <ComboBoxItem Content="Error"/>
                                    <ComboBoxItem Content="Debug"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnOpenLogFolder" Content="打开日志文件夹" Style="{StaticResource GhostBtn}"
                                        Padding="13,6" Click="BtnOpenLogFolder_Click"/>
                                <TextBlock Text="所有改动自动保存" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- ============ 二级页：开发者选项（训练数据采集等开发调试功能） ============ -->
                    <StackPanel x:Name="SetTabDev" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Margin="0,2,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Text="训练数据采集（存帧）" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="520">
                                <Run Text="面向"/>
                                <Run Text="开发调试" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                <Run Text="：挂机时按设定间隔自动保存画面 JPG，用于积累自定义识别模型的训练集，"/>
                                <Run Text="普通用户无需开启" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                <Run Text="。"/>
                            </TextBlock>
                            <CheckBox x:Name="ChkFrameDump" Content="启用：挂机时按间隔自动保存画面 JPG" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="存帧间隔" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbFrameDumpInterval" Width="110" Margin="10,0,0,0" SelectedIndex="2">
                                    <ComboBoxItem Content="2 秒"/>
                                    <ComboBoxItem Content="5 秒"/>
                                    <ComboBoxItem Content="10 秒"/>
                                    <ComboBoxItem Content="30 秒"/>
                                    <ComboBoxItem Content="60 秒"/>
                                </ComboBox>
                                <Button x:Name="BtnOpenCaptures" Content="打开存帧目录" Margin="12,0,0,0" Width="110"
                                        Style="{StaticResource PrimaryBtn}" Click="BtnOpenCaptures_Click"/>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="520">
                                <Run Text="保存到 exe 同级 "/>
                                <Run Text="captures\日期\" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text=" 目录（每张约 100KB，10 秒间隔挂机一晚约 30MB）。标注训练完成后把 "/>
                                <Run Text="yolo26n.onnx + classes.txt" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
                                <Run Text=" 放回 models\yolo\ 即可生效。更改在下次开始挂机时生效。"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 关于面板（左栏独立分类：诊断报告 / 声明 / 反馈） ===== -->
            <ScrollViewer x:Name="AboutPanel" Grid.Row="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,0">
                    <!-- ===== 诊断报告 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,2,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Rectangle Style="{StaticResource CardTitleBar}"/>
                                <TextBlock Style="{StaticResource H2}"><Run Text="★ " Foreground="{DynamicResource Warning}"/>诊断报告</TextBlock>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="520">
                                <Run Text="出问题点这里：一键收集"/>
                                <Run Text="系统环境信息、本程序日志与崩溃记录" Foreground="{DynamicResource AccentGlow}" FontWeight="SemiBold"/>
